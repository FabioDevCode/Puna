{{!--
Name: btn_download_all_files
Parameters:
- inbox_id: NUMBER (inbox id)
Usage:
{{> _ui/btn_download_all_files
inbox_id=inbox.id
}}
--}}

<button id="btn_download_zip_{{inbox_id}}" class="btn btn-sm btn-neutral" data-zip-download data-inbox-id="{{inbox_id}}"
    data-modal-id="modal_downloading_zip_{{inbox_id}}">
    <i class="fa-solid fa-download"></i>
    <span class="hidden md:inline">Télécharger tout</span>
</button>

<!-- Modal de téléchargement ZIP -->
<dialog id="modal_downloading_zip_{{inbox_id}}" class="modal">
    <div class="modal-box w-11/12 md:w-4/12 lg:w-3/12 text-center">
        <h3 class="font-bold text-lg mb-4">Préparation du téléchargement</h3>
        <div class="flex justify-center mb-4">
            <span class="loading loading-spinner loading-lg text-secondary"></span>
        </div>
        <p class="text-sm text-muted">
            Veuillez patienter pendant la création de l'archive ZIP...
        </p>
    </div>
</dialog>