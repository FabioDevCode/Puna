<dialog id="modal_form_template" class="modal">
    <form method="post" action="/form/{{form.id}}/template" class="modal-box w-11/12 max-w-3xl">
        <h2 class="text-lg font-bold mb-2">
            Modifier le template du formulaire
        </h2>
        <p class="py-2 text-sm text-muted">
            Renommez les champs tels qu'ils doivent apparaître.
        </p>

        <div class="grid grid-cols-2 gap-4 mt-4">
            <div class="col-span-1">
                <h4 class="font-medium mb-2 px-2">
                    Clé (identifiant)
                </h4>
                <div class="space-y-2 py-2 px-2 max-h-64 overflow-auto">
                    {{#if form.template_entries}}
                        {{#each form.template_entries}}
                            <div class="px-2 py-1 rounded h-[32px] bg-neutral-content/50 text-sm bg-base-100">
                                {{this.key}}
                            </div>
                        {{/each}}
                    {{else}}
                        <p class="text-sm text-muted">Aucune clé définie pour ce formulaire.</p>
                    {{/if}}
                </div>
            </div>

            <div class="col-span-1">
                <h4 class="font-medium mb-2 px-2">
                    Libellé (modifiable)
                </h4>
                <div class="space-y-2 py-2 px-2 max-h-64 overflow-auto">
                    {{#if form.template_entries}}
                        {{#each form.template_entries}}
                        <div class="flex items-center gap-2">
                            <input type="text" name="template[{{this.key}}]" value="{{this.value}}" class="input input-bordered w-full input-sm" />
                        </div>
                        {{/each}}
                    {{/if}}
                </div>
            </div>
        </div>

        <div class="modal-action mt-4">
            <button type="button" class="btn btn-sm" onclick="document.getElementById('modal_form_template').close()">
                Annuler
            </button>
            <button type="submit" class="btn btn-sm btn-secondary">
                Enregistrer
            </button>
        </div>
    </form>
</dialog>
