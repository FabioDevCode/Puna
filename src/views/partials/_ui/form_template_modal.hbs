<button id="btn_open_template" class="btn btn-sm btn-warning none" type="button" onclick="document.getElementById('modal_form_template').showModal()">
    <i class="fa-solid fa-sliders"></i>
    Template
</button>

<dialog id="modal_form_template" class="modal">
    <form id="modal_template_form" method="post" action="#" class="modal-box w-11/12 max-w-3xl">
        <h2 class="text-lg font-bold mb-2">Modifier le template du formulaire</h2>
        <p class="py-2 text-sm text-muted">Renommez les champs tels qu'ils doivent apparaître.</p>

        <div class="grid grid-cols-2 gap-4 mt-4">
            <div class="col-span-1">
                <h4 class="mb-2 px-2">Clé (identifiant)</h4>
                <div id="modal_template_keys" class="space-y-2 py-2 px-2 max-h-64 overflow-auto"></div>
            </div>

            <div class="col-span-1">
                <h4 class="mb-2 px-2">Libellé (modifiable)</h4>
                <div id="modal_template_values" class="space-y-2 py-2 px-2 max-h-64 overflow-auto"></div>
            </div>
        </div>

        <div class="modal-action mt-4">
            <button type="button" class="btn btn-sm" onclick="document.getElementById('modal_form_template').close()">Annuler</button>
            <button type="submit" class="btn btn-sm btn-secondary">Enregistrer</button>
        </div>
    </form>
</dialog>
