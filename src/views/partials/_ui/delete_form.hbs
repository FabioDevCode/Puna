<button class="btn btn-sm btn-error btn-outline none" id="btn_delete_form"
    onclick="document.getElementById('modal_delete_form').showModal()">
    <i class="far fa-trash-alt"></i>
    <span class="hidden md:flex">
        Supprimer ce formulaire
    </span>
</button>

<dialog id="modal_delete_form" class="modal">
    <div class="modal-box w-11/12 md:w-6/12 lg:w-5/12">
        <h3 class="font-bold text-lg">Confirmer la suppression</h3>
        <p class="py-4">Êtes-vous sûr de vouloir supprimer ce formulaire ? Cette action est irréversible.</p>

        <form id="formDeleteForm" action="/delete-form" method="post" class="hidden">
            <input type="hidden" name="form_id" id="form_delete_id" value="" />
        </form>

        <div class="modal-action mt-2">
            <form method="dialog">
                <button class="btn btn-sm">Annuler</button>
            </form>
            <button type="submit" form="formDeleteForm" class="btn btn-sm btn-error">Supprimer</button>
        </div>
    </div>
</dialog>