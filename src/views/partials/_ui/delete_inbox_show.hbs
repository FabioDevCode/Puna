{{!--
Name: delete_inbox_show
Parameters:
- inbox_id: NUMBER (inbox id)
- form_name: STRING (form name)
- site_id: STRING (site id)
Usage:
{{> _ui/delete_inbox_show
inbox_id=inbox.id
form_name=form.name
site_id=site.id
}}
--}}

<!-- Modal de suppression d'inbox -->
<dialog id="modal_delete_inbox_show" class="modal">
    <div class="modal-box w-11/12 md:w-6/12 lg:w-5/12">
        <h3 class="font-bold text-lg">Confirmer la suppression</h3>
        <p class="py-4">
            Êtes-vous sûr de vouloir supprimer cette entrée ?<br>
            Cette action est irréversible.
        </p>

        <form id="formDeleteInboxShow" action="/inbox/{{inbox_id}}/delete?redirect=site&formName={{form_name}}"
            method="post" class="hidden">
            <input type="hidden" name="inbox_id" value="{{inbox_id}}" />
        </form>

        <div class="modal-action mt-2">
            <form method="dialog">
                <button class="btn btn-sm">Annuler</button>
            </form>
            <button type="submit" form="formDeleteInboxShow" class="btn btn-sm btn-error">Supprimer</button>
        </div>
    </div>
</dialog>

<script>
    (function () {
        const btnDelete = document.getElementById('btn_delete_inbox_show');
        const modal = document.getElementById('modal_delete_inbox_show');

        if (btnDelete && modal) {
            btnDelete.addEventListener('click', (e) => {
                e.preventDefault();
                try {
                    modal.showModal();
                } catch (err) {
                    console.error(err);
                }
            });
        }
    })();
</script>