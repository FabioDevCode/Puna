{{!--
    Name: stats
    Parameters:
    - title: STRING
    - value: INTEGER
    - desc: STRING
    Usage:
        {{> _ui/stats
            title="Valider"
            value="89"
            desc="voici ma description"
            icon="fas fa-inbox"
        }}
--}}

<div class="stats h-max bg-base-100 overflow-hidden col-span-2 md:col-span-2 lg:col-span-4 {{fallback class ''}}">
    <div class="stat">
        {{#icon}}
        <div class="stat-figure text-4xl">
            <i class="{{.}}"></i>
        </div>
        {{/icon}}

        <div class="stat-title">
            {{fallback title ''}}
        </div>
        <div class="stat-value">
            {{fallback value ''}}
        </div>
        <div class="stat-desc">
            {{fallback desc ''}}
        </div>
    </div>
</div>