{{!--
    Name: site
    Parameters:
    - id: STRING
    - domain: STRING
    - form: INTEGER
    - inbox: INTEGER
    Usage:
        {{> _ui/site
            domain="domain.fr"
            form="1"
            inbox="2"
        }}
--}}

<a href="/site/{{id}}" id="{{id}}" domain="{{domain}}" class="dash-site col-span-2 md:col-span-6 lg:col-span-6 overflow-hidden">
    <div class="card bg-neutral text-neutral-content shadow-lg relative p-4 px-4 md:px-6">
        <div class="flex flex-col md:flex-row lg:flex-row items-start md:items-center lg:items-center justify-between gap-2 md:gap-4 w-full">
            <div class="text-lg font-bold truncate ellipsis-truncate max-w-full">
                {{fallback domain '-'}}
            </div>
            <div class="flex gap-4 text-sm items-center">
                <span class="flex items-center gap-2">
                    <i class="fas fa-file-alt"></i>
                    {{fallback form '0'}}
                </span>
                <span class="flex items-center gap-2">
                    <i class="fas fa-inbox"></i>
                    {{fallback inbox '0'}}
                </span>
            </div>
        </div>
    </div>
</a>