<button class="btn btn-secondary" onclick="my_modal_new_site.showModal()">
    <i class="fas fa-plus"></i>
    Nouveau site web
</button>

<dialog id="my_modal_new_site" class="modal">
    <div class="modal-box w-4/12 max-w-5xl">
        <h2 class="text-lg font-bold mb-4">
            Créer un nouveau site
        </h2>
        <form id="fromCreateSite" action="/create-site" method="post" class="flex flex-col gap-4">
            <input type="text" name="domain" class="input input-bordered w-full" placeholder="Nom de domaine" required />
        </form>
        <div class="modal-action flex gap-1">
            <button type="submit" form="fromCreateSite" class="btn btn-secondary">Créer</button>
            <form method="dialog">
                <button class="btn">Fermer</button>
            </form>
        </div>
    </div>
</dialog>