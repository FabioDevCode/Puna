{{!--
    Name: delete_site
    Parameters:
    - id: STRING
    - domain: STRING
    Usage:
        {{> _ui/delete_site
            id=1
            domain="puna.fr"
        }}
--}}

<button class="btn btn-error" onclick="delete_site_modal.showModal()">
	<i class="far fa-trash-alt"></i>
	<span>Supprimer <b>{{domain}}</b></span>
</button>

<dialog id="delete_site_modal" class="modal">
	<div class="modal-box w-4/12 max-w-5xl">
		<h2 class="text-lg font-bold mb-4 text-error">
			Confirmer la suppression du site
		</h2>
		<p class="mb-2">Pour supprimer ce site, veuillez saisir <b>{{domain}}</b>&nbsp;:</p>
		<form id="formDeleteSite" action="/delete-site/{{id}}" method="post" class="flex flex-col gap-4">
			<input type="text" name="confirm_domain" class="input input-bordered w-full" placeholder="{{site.domain}}" required="" />
		</form>
		<div class="modal-action flex gap-1">
			<button type="submit" form="formDeleteSite" class="btn btn-error">Confirmer la suppression</button>
			<form method="dialog">
				<button class="btn">Annuler</button>
			</form>
		</div>
	</div>
</dialog>
