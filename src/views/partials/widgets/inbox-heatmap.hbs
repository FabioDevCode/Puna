<div id="statH" class="bg-base-100 stats-item p-4 stats-item--h shadow-xl">
    <div class="flex flex-col gap-2 w-full">
        <div class="flex items-center justify-between">
            <div class="text-sm font-semibold select-none">
                {{__ "stats.heatmap_title"}}
            </div>
            <div id="statH_range" role="tablist" class="tabs tabs-boxed tabs-sm">
                <a role="tab" class="tab tab-active" data-value="7">{{__ "stats.7_days"}}</a>
                <a role="tab" class="tab" data-value="30">{{__ "stats.30_days"}}</a>
            </div>
        </div>
        <div id="statH_chart" style="height: 280px; overflow: hidden;"></div>
    </div>

    <script src="/js/charts/inbox-heatmap.js"></script>
</div>
