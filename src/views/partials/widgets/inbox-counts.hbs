<div id="statA" class="bg-base-100 stats-item p-4 stats-item--a shadow-xl">
    <div class="flex flex-col gap-2 w-full">
        <div class="flex items-center justify-between flex-wrap gap-2">
            <div class="flex items-center gap-3 w-max">
                <div class="text-sm font-semibold select-none w-max">
                    {{__ "stats.inbox_count_title"}}
                </div>
                <span id="statA_total" class="text-xs font-medium badge badge-ghost w-max"></span>
            </div>
            <div id="statA_range" role="tablist" class="tabs tabs-boxed tabs-sm w-max">
                <a role="tab" class="tab w-max tab-active" data-value="7">{{__ "stats.7_days"}}</a>
                <a role="tab" class="tab w-max" data-value="30">{{__ "stats.30_days"}}</a>
            </div>
        </div>
        <div id="statA_chart" class="overflow-hidden h-[344px]"></div>
    </div>
</div>

<script src="/js/charts/inbox-counts.js"></script>
