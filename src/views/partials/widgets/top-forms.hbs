<div id="statTopFroms"
class="bg-base-100 h-[350px] w-full flex flex-col gap-4 p-4 justify-between stats-item flex-1 shadow-xl">
    <div class="flex items-center justify-between w-full flex-wrap gap-2">
        <div class="text-sm font-semibold select-none w-max">
            {{__ "stats.top_forms_title"}}
        </div>
        <div id="statTop_range" role="tablist" class="tabs tabs-boxed tabs-sm w-max">
            <a role="tab" class="tab w-max tab-active" data-value="7">{{__ "stats.7_days"}}</a>
            <a role="tab" class="tab w-max" data-value="30">{{__ "stats.30_days"}}</a>
        </div>
    </div>

    <div id="tableTopContainer" class="overflow-x-auto w-full border border-base-200">
        <table id="statTopTable" class="table w-full table-pin-cols bg-base-100">
            <thead>
                <tr>
                    <th>#</th>
                    <th>{{__ "form.label"}}</th>
                    <th>{{__ "stats.site_header"}}</th>
                    <th class="text-right">{{__ "stats.entries_header"}}</th>
                </tr>
            </thead>
            <tbody id="statTop_body">
                <tr>
                    <td colspan="3" class="text-center text-sm text-muted">{{__ "common.loading"}}</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<script src="/js/charts/top-forms.js"></script>
