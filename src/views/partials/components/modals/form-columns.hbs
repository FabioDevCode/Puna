<button id="btn_columns" class="btn btn-sm">
    <i class="fa-solid fa-table-columns"></i>
    <span class="hidden md:flex">
        {{__ "form.columns_title"}}
    </span>
</button>

<dialog id="modal_columns" class="modal">
    <form id="modal_columns_form" class="modal-box w-11/12 max-w-md" method="dialog">
        <h2 class="text-lg font-bold mb-2">{{__ "form.columns_title"}}</h2>
        <p class="py-1 text-sm text-muted">{{__ "form.columns_desc"}}</p>

        <div id="modal_columns_list" class="mt-2 max-h-72 overflow-auto grid grid-cols-1 gap-0"></div>

        <div class="modal-action">
            <button type="button" class="btn btn-sm" id="modal_columns_cancel">{{__ "btn.cancel"}}</button>
            <button type="submit" class="btn btn-sm btn-secondary" id="modal_columns_save">{{__ "btn.save"}}</button>
        </div>
    </form>
</dialog>
