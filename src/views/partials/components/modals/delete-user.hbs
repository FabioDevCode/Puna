<!-- Modal de suppression d'utilisateur -->
<dialog id="modal_delete_user" class="modal">
    <div class="modal-box w-11/12 md:w-6/12 lg:w-5/12">
        <h3 class="font-bold text-lg text-error">
            {{__ "admin.delete_user_title"}}
        </h3>
        <p class="py-2">
            {{__ "admin.confirm_delete_user"}}<br>
            {{__ "common.action_irreversible"}}
        </p>

        <form id="formDeleteUser" action="" method="post" class="flex flex-col gap-4">
            <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <input type="hidden" name="user_id" id="user_delete_id" value="" />

    <div class="form-control w-full">
        <label class="label">
            <span class="label-text font-semibold">{{__ "admin.confirm_with_password"}} <span
            class="text-error">*</span></span>
</label>
<input type="password" id="delete_user_password" name="password" placeholder="{{__ "admin.your_password_placeholder"}}"
class="input input-sm input-bordered w-full" autocomplete="current-password" required />
</div>
</form>

<div class="modal-action mt-4">
    <form method="dialog">
        <button class="btn btn-sm">{{__ "btn.cancel"}}</button>
    </form>
    <button type="submit" form="formDeleteUser" id="confirmDeleteUserBtn" class="btn btn-sm btn-error" disabled>
        <i class="fa-solid fa-trash"></i>
        {{__ "btn.delete"}}
    </button>
</div>
</div>
<form method="dialog" class="modal-backdrop">
    <button>close</button>
</form>
</dialog>
