<dialog id="modal_show_mcp_token" class="modal">
    <div class="modal-box w-11/12 md:w-7/12 lg:w-5/12 max-w-2xl">
        <h2 class="text-lg font-bold mb-4">{{__ "mcp.token_created_title"}}</h2>

        <div class="alert alert-warning text-sm rounded-lg mb-4">
            <i class="fas fa-triangle-exclamation mr-1"></i>
            <span>{{{__ "mcp.token_warning"}}}</span>
        </div>

        <div class="flex items-center gap-2">
            <input id="mcp-token-display" type="text" class="input input-sm input-bordered w-full font-mono text-xs" readonly />
    </div>

    <div class="modal-action mt-6">
        <button id="btn-copy-mcp-token" class="btn btn-sm btn-outline btn-info" title="{{__ "mcp.token_copy_title"}}">
            <i class="fas fa-copy"></i>
            <span class="hidden md:flex">
                {{__ "mcp.token_copy_title"}}
            </span>
        </button>

        <form method="dialog">
            <button class="btn btn-sm" id="btn-close-mcp-token">{{__ "btn.close"}}</button>
        </form>
    </div>
</div>
</dialog>
