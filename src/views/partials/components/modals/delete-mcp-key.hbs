<dialog id="modal_delete_mcp_key" class="modal">
    <div class="modal-box w-11/12 md:w-6/12 lg:w-5/12">
        <h3 class="font-bold text-lg text-error">{{__ "modal.confirm_delete"}}</h3>
        <p class="py-2">
            {{__ "mcp.confirm_delete_text"}} <strong id="mcp-delete-key-name"></strong> ?<br>
            {{__ "common.action_irreversible"}}
        </p>

        <div class="modal-action mt-1">
            <form method="dialog">
                <button class="btn btn-sm">{{__ "btn.cancel"}}</button>
            </form>
            <button id="btn-confirm-delete-mcp-key" class="btn btn-sm btn-error">{{__ "btn.delete"}}</button>
        </div>
    </div>
</dialog>
