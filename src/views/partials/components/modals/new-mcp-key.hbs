<dialog id="modal_new_mcp_key" class="modal">
    <div class="modal-box w-11/12 md:w-7/12 lg:w-5/12 max-w-2xl">
        <h2 class="text-lg font-bold mb-1">Nouvelle clé d'accès MCP</h2>
        <p class="text-sm text-gray-500 mb-4">Donnez un nom à votre clé, choisissez son niveau d'accès et optionnellement une date d'expiration.</p>

        <div class="flex flex-col gap-4">
            <div>
                <label class="label py-1">
                    <span class="label-text font-medium">Nom <span class="text-error">*</span></span>
                </label>
                <input id="mcp-key-name" type="text" class="input input-sm input-bordered w-full" placeholder="ex: Mon outil IA" maxlength="100" />
            <p id="mcp-key-name-error" class="text-sm text-error mt-1 hidden"></p>
        </div>

        <div>
            <label class="label py-1">
                <span class="label-text font-medium">Niveau d'accès <span class="text-error">*</span></span>
            </label>
            <select id="mcp-key-scope" class="select select-sm select-bordered w-full">
                <option value="read">read — Lecture seule</option>
                <option value="read_write">read_write — Lecture et écriture</option>
                <option value="read_write_access">read_write_access — Accès complet</option>
            </select>
        </div>

        <div>
            <label class="label py-1">
                <span class="label-text font-medium">Date d'expiration <span class="text-gray-400">(optionnel)</span></span>
            </label>
            <input id="mcp-key-expires" type="date" class="input input-sm input-bordered w-full" />
    </div>
</div>

<div class="modal-action mt-6">
    <form method="dialog">
        <button class="btn btn-sm" id="btn-cancel-mcp-key">Annuler</button>
    </form>
    <button id="btn-submit-mcp-key" class="btn btn-sm btn-secondary">Créer la clé</button>
</div>
</div>
</dialog>
