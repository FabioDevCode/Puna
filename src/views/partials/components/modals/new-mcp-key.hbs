<dialog id="modal_new_mcp_key" class="modal">
    <div class="modal-box w-11/12 md:w-7/12 lg:w-5/12 max-w-2xl">
        <h2 class="text-lg font-bold mb-1">{{__ "mcp.create_title"}}</h2>
        <p class="text-sm text-gray-500 mb-4">{{__ "mcp.create_help"}}</p>

        <div class="flex flex-col gap-4">
            <div>
                <label class="label py-1">
                    <span class="label-text font-medium">{{__ "mcp.key_name_label"}} <span class="text-error">*</span></span>
                </label>
                <input id="mcp-key-name" type="text" class="input input-sm input-bordered w-full" placeholder="{{__ "mcp.key_name_placeholder"}}" maxlength="100" />
            <p id="mcp-key-name-error" class="text-sm text-error mt-1 hidden"></p>
        </div>

        <div>
            <label class="label py-1">
                <span class="label-text font-medium">{{__ "mcp.key_scope_label"}} <span class="text-error">*</span></span>
            </label>
            <select id="mcp-key-scope" class="select select-sm select-bordered w-full">
                <option value="read">{{__ "mcp.scope_read"}}</option>
                <option value="read_write">{{__ "mcp.scope_read_write"}}</option>
                <option value="read_write_access">{{__ "mcp.scope_read_write_access"}}</option>
            </select>
        </div>

        <div>
            <label class="label py-1">
                <span class="label-text font-medium">{{__ "mcp.key_expires_label"}} <span class="text-gray-400">{{__ "mcp.optional"}}</span></span>
            </label>
            <input id="mcp-key-expires" type="text" class="input input-sm input-bordered w-full" placeholder="YYYY-MM-DD" />
    </div>
</div>

<div class="modal-action mt-6">
    <form method="dialog">
        <button class="btn btn-sm" id="btn-cancel-mcp-key">{{__ "btn.cancel"}}</button>
    </form>
    <button id="btn-submit-mcp-key" class="btn btn-sm btn-secondary">{{__ "mcp.btn_create_key"}}</button>
</div>
</div>
</dialog>
