<!-- Modal Création Utilisateur -->
<dialog id="createUserModal" class="modal">
    <div class="modal-box w-11/12 max-w-2xl">
        <h3 class="font-bold text-lg mb-2">
            {{__ "admin.new_user_title"}}
        </h3>

        <form id="formCreateUser" action="/admin/users/create" method="POST" class="flex flex-col gap-4">
            <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <!-- Login & Email -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="form-control w-full">
                <label class="label">
                    <span class="label-text font-semibold">{{__ "admin.login_label"}} <span class="text-error">*</span></span>
                </label>
                <input type="text" name="login" placeholder="ex: jdupont"
                class="input input-sm input-bordered w-full" required />
            </div>

            <div class="form-control w-full">
                <label class="label">
                    <span class="label-text font-semibold">{{__ "admin.email_label"}} <span class="text-error">*</span></span>
                </label>
                <input type="email" name="email" placeholder="ex: jean.dupont@example.com"
                class="input input-sm input-bordered w-full" required />
            </div>
        </div>

        <!-- Role -->
        <div class="form-control w-full">
            <label class="label">
                <span class="label-text font-semibold">{{__ "admin.role_label"}} <span class="text-error">*</span></span>
            </label>
            <select name="role" class="select select-sm select-bordered w-full" required>
                <option value="" disabled selected>{{__ "admin.select_role"}}</option>
                <option value="viewer">{{__ "admin.role_viewer"}}</option>
                <option value="editor">{{__ "admin.role_editor"}}</option>
                <option value="owner">{{__ "admin.role_owner"}}</option>
                <option value="unique">{{__ "admin.role_unique"}}</option>
            </select>
        </div>

        <!-- Sites assignés -->
        <div class="form-control w-full">
            <label class="label">
                <span class="label-text font-semibold">{{__ "admin.assigned_sites"}}</span>
            </label>

            <!-- Recherche de sites -->
            <div class="relative mb-2">
                <input type="text" id="siteSearchInput" placeholder="{{__ "admin.filter_sites_placeholder"}}"
                class="input input-sm input-bordered w-full pl-8">
                <i
                class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-neutral-content text-xs"></i>
        </div>

        <!-- Liste des sites (Checkboxes) -->
        <div id="sitesListContainer"
        class="border border-base-300 rounded-lg h-48 overflow-y-auto bg-base-100 p-1">
            {{#each sites}}
                <label
                class="cursor-pointer label hover:bg-base-200 rounded-md px-3 py-2 transition-colors justify-start gap-3">
                    <input type="checkbox" name="sites" value="{{this.id}}"
                    class="checkbox checkbox-sm checkbox-neutral rounded-md" />
                    <span class="label-text flex-1 truncate" title="{{this.domain}}">{{this.domain}}</span>
                </label>
            {{else}}
                <div class="text-center text-neutral text-sm p-8 flex flex-col items-center gap-2">
                    <i class="fa-solid fa-globe text-2xl opacity-20"></i>
                    <span>{{__ "admin.no_sites_available"}}</span>
                </div>
            {{/each}}

            <!-- Message aucun résultat recherche -->
            <div id="noSiteFound" class="hidden text-center text-neutral text-sm p-4">
                {{__ "admin.no_sites_match"}}
            </div>
        </div>

        <label class="label">
            <span class="label-text-alt text-neutral">{{__ "admin.sites_selection_hint"}}</span>
        </label>
    </div>

    <!-- Email de bienvenue (visible uniquement si le mail est configuré) -->
    {{#if mailEnabled}}
        <div class="form-control">
            <label class="label cursor-pointer justify-start gap-3">
                <input type="checkbox" name="sendWelcomeEmail" value="on"
                class="checkbox checkbox-sm checkbox-neutral rounded-md" />
                <span class="label-text">{{__ "admin.send_welcome_email"}}</span>
            </label>
        </div>
    {{/if}}
</form>

<div class="modal-action mt-2">
    <form method="dialog">
        <!-- Le bouton annuler ferme la modale car il est dans un form method="dialog" -->
        <button class="btn btn-sm">{{__ "btn.cancel"}}</button>
    </form>
    <button type="submit" form="formCreateUser" class="btn btn-sm btn-secondary gap-2">
        {{__ "admin.create_user_submit"}}
    </button>
</div>
</div>
<form method="dialog" class="modal-backdrop">
    <button>close</button>
</form>
</dialog>
