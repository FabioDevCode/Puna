{{#if showButton}}
    <button id="btn_open_template" class="btn btn-sm btn-warning none" type="button">
        <i class="fa-regular fa-paste"></i>
        <span class="hidden md:flex">
            {{__ "form.template_btn"}}
        </span>
    </button>
{{/if}}

<dialog id="modal_form_template" class="modal">
    <form id="modal_template_form" method="post" action="#" class="modal-box w-11/12 max-w-3xl">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
    <h2 class="text-lg font-bold mb-2 select-none">{{__ "form.template_title"}}</h2>
    <p class="py-2 text-sm text-muted select-none">{{__ "form.template_desc"}}</p>

    <div class="grid grid-cols-2 gap-4 mt-4">
        <div class="col-span-2">
            <div class="max-h-64 overflow-auto grid grid-cols-2 gap-4">
                <div class="col-span-1">
                    <h4 class="mb-2 px-2 select-none">{{__ "form.template_key"}}</h4>
                    <div id="modal_template_keys" class="space-y-2 py-2 px-2"></div>
                </div>

                <div class="col-span-1">
                    <h4 class="mb-2 px-2 select-none">{{__ "form.template_label"}}</h4>
                    <div id="modal_template_values" class="space-y-2 py-2 px-2"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-action mt-4">
        <button type="button" class="btn btn-sm" data-close-modal="modal_form_template">{{__ "btn.cancel"}}</button>
        <button type="submit" class="btn btn-sm btn-secondary">{{__ "btn.save"}}</button>
    </div>
</form>
</dialog>
