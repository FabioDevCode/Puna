{{#if showButton}}
    <button id="btn_open_template" class="btn btn-sm btn-warning none" type="button"
    onclick="document.getElementById('modal_form_template').showModal()">
        <i class="fa-regular fa-paste"></i>
        <span class="hidden md:flex">
            Template
        </span>
    </button>
{{/if}}

<dialog id="modal_form_template" class="modal">
    <form id="modal_template_form" method="post" action="#" class="modal-box w-11/12 max-w-3xl">
        <h2 class="text-lg font-bold mb-2 select-none">Modifier le template du formulaire</h2>
        <p class="py-2 text-sm text-muted select-none">Renommez les champs tels qu'ils doivent apparaître.</p>

        <div class="grid grid-cols-2 gap-4 mt-4">
            <div class="col-span-2">
                <div class="max-h-64 overflow-auto grid grid-cols-2 gap-4">
                    <div class="col-span-1">
                        <h4 class="mb-2 px-2 select-none">Clé (identifiant)</h4>
                        <div id="modal_template_keys" class="space-y-2 py-2 px-2"></div>
                    </div>

                    <div class="col-span-1">
                        <h4 class="mb-2 px-2 select-none">Libellé (modifiable)</h4>
                        <div id="modal_template_values" class="space-y-2 py-2 px-2"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-action mt-4">
            <button type="button" class="btn btn-sm"
            onclick="document.getElementById('modal_form_template').close()">Annuler</button>
        <button type="submit" class="btn btn-sm btn-secondary">Enregistrer</button>
    </div>
</form>
</dialog>






