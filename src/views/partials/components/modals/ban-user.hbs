<!-- Modal de bannissement d'utilisateur -->
<dialog id="modal_ban_user" class="modal">
    <div class="modal-box w-11/12 md:w-6/12 lg:w-5/12">
        <h3 class="font-bold text-lg text-error">
            {{__ "admin.ban_user_title"}}
        </h3>
        <p class="py-2">
            {{__ "admin.confirm_ban_user"}}
        </p>

        <form id="formBanUser" action="" method="post" class="flex flex-col gap-4">
            <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <input type="hidden" name="status" value="banned" />

    <div class="form-control w-full">
        <label class="label">
            <span class="label-text font-semibold">
                {{__ "admin.ban_reason_label"}}
                <span class="text-error">
                    *
                </span>
            </span>
        </label>
        <textarea id="ban_user_reason" name="reason" placeholder="{{__ "admin.ban_reason_placeholder"}}"class="textarea textarea-bordered w-full" required></textarea>
    </div>
</form>

<div class="modal-action mt-4">
    <form method="dialog">
        <button class="btn btn-sm">{{__ "btn.cancel"}}</button>
    </form>
    <button type="submit" form="formBanUser" id="confirmBanUserBtn" class="btn btn-sm btn-error" disabled>
        <i class="fa-solid fa-ban"></i>
        {{__ "admin.ban"}}
    </button>
</div>
</div>
<form method="dialog" class="modal-backdrop">
    <button>close</button>
</form>
</dialog>
