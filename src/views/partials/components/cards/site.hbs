{{!--
Name: site
Parameters:
- id: STRING
- domain: STRING
- creatorLogin: STRING (optional)
- form: INTEGER
- inbox: INTEGER
--}}

<a href="/site/{{id}}/view" id="{{id}}" domain="{{domain}}" class="dash-site col-span-2 md:col-span-6 lg:col-span-6">
    <div class="card bg-base-100 text-neutral hover:bg-neutral hover:text-base-100 shadow-lg relative p-4 px-4 md:px-6">
        <div
        class="flex flex-col md:flex-row lg:flex-row items-start md:items-center lg:items-center justify-between gap-2 md:gap-4 w-full">
            <div class="flex flex-col min-w-0">
                <div class="text-lg font-bold truncate ellipsis-truncate max-w-full">
                    {{fallback domain '-'}}
                </div>
                {{#if creatorLogin}}
                    <span class="text-xs opacity-60">
                        {{creatorLogin}}
                    </span>
                {{else}}
                    <span class="text-xs opacity-60">
                        -
                    </span>
                {{/if}}
            </div>
            <div class="flex gap-4 text-sm items-center">
                <span class="flex items-center gap-2">
                    <i class="fa-regular fa-file-lines"></i>
                    {{fallback form '0'}}
                </span>
                <span class="flex items-center gap-2">
                    <i class="fas fa-inbox"></i>
                    {{fallback inbox '0'}}
                </span>
            </div>
        </div>
    </div>
</a>
