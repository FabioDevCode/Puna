<aside class="hidden md:flex md:flex-col md:min-w-[208px] md:w-[208px] h-screen bg-base-100 p-2">
    <a href="/dashboard" class="flex justify-start items-center p-4 cursor-pointer gap-2">
        <div class="w-[24px] select-none">
            <img src="/img/puna_short_logo.png" alt="Puna logo">
        </div>
        <h1 class="text-2xl mt-1">
            Puna
        </h1>
    </a>

    <!-- Menu Administration -->
    <nav class="flex-1">
        <div class="px-4 py-2 text-xs font-bold text-neutral-content uppercase tracking-wider">
            Administration
        </div>
        <ul class="menu p-2 gap-[1px] rounded-lg">
            <li>
                <a href="/admin"
                class="hover:bg-neutral hover:text-base-100 rounded-lg flex items-center gap-2 px-3 py-2">
                    <i class="fa-solid fa-chart-bar"></i>
                    Vue d'ensemble
                </a>
            </li>
            <li>
                <a href="/admin/users"
                class="hover:bg-neutral hover:text-base-100 rounded-lg flex items-center gap-2 px-3 py-2">
                    <i class="fa-solid fa-users"></i>
                    Utilisateurs
                </a>
            </li>
            {{#roleIs roles='super_admin'}}
                <li>
                    <a href="/admin/logs"
                    class="hover:bg-neutral hover:text-base-100 rounded-lg flex items-center gap-2 px-3 py-2">
                        <i class="fa-solid fa-list-ul"></i>
                        Logs
                    </a>
                </li>
                <li>
                    <a href="/admin/settings"
                    class="hover:bg-neutral hover:text-base-100 rounded-lg flex items-center gap-2 px-3 py-2">
                        <i class="fa-solid fa-gears"></i>
                        Paramètres
                    </a>
                </li>
            {{/roleIs}}
        </ul>
    </nav>

    <!-- Bas du menu -->
    <div class="mt-auto text-sm text-neutral">
        {{#roleIs roles='super_admin,owner'}}
            <ul class="menu p-2 gap-[1px] rounded-lg">
                <li>
                    <a href="/dashboard" class="hover:bg-neutral hover:border-neutral text-neutral border border-grey hover:text-base-100">
                        <i class="fa-solid fa-tv"></i>
                        App
                    </a>
                </li>
            </ul>
        {{/roleIs}}

        <div class="p-2 mx-2 border border-grey flex flex-col gap-2 rounded-xl">
            <div class="flex items-center gap-2 select-none">
                <div class="w-8 h-8 rounded rounded-lg bg-neutral/15 flex justify-center items-center">
                    <i class="fa-regular fa-user"></i>
                </div>
                <p>
                    {{connectedUser.login}}
                </p>
            </div>
        </div>

        <ul class="menu p-2 gap-[1px]">
            <li>
                <a href="/dp-logout" class="hover:bg-neutral hover:border-neutral text-neutral border border-grey hover:text-base-100">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    Se déconnecter
                </a>
            </li>
        </ul>

        <p class="flex text-neutral-content text-xs pl-4 select-none">
            0.0.1-beta
        </p>
    </div>
</aside>










