<aside class="hidden md:flex md:flex-col md:min-w-[208px] md:w-[208px] h-screen bg-base-100 p-2">
    <a href="/dashboard" class="flex justify-start items-center p-4 cursor-pointer">
        <div class="w-[112px] select-none">
            <img src="/img/puna_long_logo_colored.png" alt="Puna long logo">
        </div>
    </a>

    <!-- Menu Administration -->
    <nav class="flex-1">
        <ul class="menu p-2 gap-[1px] rounded-lg">
            <div class="dropdown dropdown-hover">
                <li tabindex="0" role="button">
                    <a class="hover:bg-secondary-content/75 hover:text-secondary text-secondary rounded-lg flex items-center gap-2 px-3 py-2 border border-secondary-content/75">
                        <i class="fa-solid fa-sliders"></i>
                        Administration
                    </a>
                </li>
                <ul tabindex="0" class="dropdown-content menu bg-base-100 border border-secondary rounded-box z-[1] w-[176px] p-2 shadow-lg">
                    <li>
                        <a href="/dashboard" class="hover:bg-neutral hover:text-base-100">
                            <i class="fa-solid fa-tv"></i>
                            App
                        </a>
                    </li>
                </ul>
            </div>
        </ul>

        <div class="px-4 py-2 text-xs font-bold text-neutral-content uppercase tracking-wider">
            Administration
        </div>
        <ul class="menu p-2 gap-[1px] rounded-lg">
            <li>
                <a href="/admin"
                    class="hover:bg-neutral hover:text-base-100 rounded-lg flex items-center gap-2 px-3 py-2">
                    <i class="fa-solid fa-chart-bar"></i>
                    Vue d'ensemble
                </a>
            </li>
            <li>
                <a href="/admin/users"
                    class="hover:bg-neutral hover:text-base-100 rounded-lg flex items-center gap-2 px-3 py-2">
                    <i class="fa-solid fa-users"></i>
                    Utilisateurs
                </a>
            </li>
            {{#roleIs roles='super_admin'}}
            <li>
                <a href="/admin/settings"
                    class="hover:bg-neutral hover:text-base-100 rounded-lg flex items-center gap-2 px-3 py-2">
                    <i class="fa-solid fa-gears"></i>
                    Paramètres
                </a>
            </li>
            {{/roleIs}}
        </ul>
    </nav>

    <!-- Bas du menu -->
    <div class="mt-auto text-sm text-neutral">
        <ul class="menu p-2 gap-[1px] rounded-lg">
            {{#if connectedUser}}
            <li>
                <a>
                    <i class="fa-regular fa-user"></i>
                    {{connectedUser.login}}
                </a>
            </li>
            {{/if}}
            <li>
                <a href="/dp-logout"
                    class="hover:bg-neutral hover:text-base-100 rounded-lg flex items-center gap-2 px-3 py-2">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    Se déconnecter
                </a>
            </li>
        </ul>
        <p class="flex text-neutral-content text-xs pl-4 select-none">
            beta-0.0.1
        </p>
    </div>
</aside>