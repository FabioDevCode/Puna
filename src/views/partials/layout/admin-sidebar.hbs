<aside class="hidden md:flex md:flex-col md:min-w-[208px] md:w-[208px] h-screen bg-base-100 p-2">
    <a href="/dashboard" class="flex justify-start items-center p-4 cursor-pointer gap-2">
        <div class="w-[28px] select-none">
            <img src="/img/puna_short_logo.png" alt="Puna logo">
        </div>
    </a>

    <ul class="menu p-2 gap-[1px] rounded-lg">
        {{#roleIs roles='super_admin,owner'}}
            <li>
                <a href="/dashboard" class="rounded-lg flex items-center gap-2 px-3 py-2 hover:bg-neutral hover:text-base-100">
                    <i class="fa-solid fa-display"></i>
                    {{__ "menu.app"}}
                </a>
            </li>
        {{/roleIs}}
    </ul>

    <!-- Menu Administration -->
    <nav class="flex-1">
        <div class="px-4 py-2 text-xs font-bold text-neutral-content uppercase tracking-wider">
            {{__ "menu.administration"}}
        </div>
        <ul class="menu p-2 gap-[1px] rounded-lg">
            <li>
                <a href="/admin" class="hover:bg-neutral hover:text-base-100 rounded-lg flex items-center gap-2 px-3 py-2">
                    <i class="fa-solid fa-chart-bar"></i>
                    {{__ "admin.overview"}}
                </a>
            </li>
            <li>
                <a href="/admin/users" class="hover:bg-neutral hover:text-base-100 rounded-lg flex items-center gap-2 px-3 py-2">
                    <i class="fa-solid fa-users-line"></i>
                    {{__ "admin.users"}}
                </a>
            </li>
            {{#roleIs roles='super_admin'}}
                {{!-- <li>
                <a href="/admin/settings" class="hover:bg-neutral hover:text-base-100 rounded-lg flex items-center gap-2 px-3 py-2">
                    <i class="fa-solid fa-gears"></i>
                    {{__ "admin.settings"}}
                </a>
            </li> --}}
            <li>
                <a href="/admin/logs" class="hover:bg-neutral hover:text-base-100 rounded-lg flex items-center gap-2 px-3 py-2">
                    <i class="fa-solid fa-list"></i>
                    {{__ "admin.logs"}}
                </a>
            </li>
        {{/roleIs}}
    </ul>
</nav>

<!-- Bas du menu -->
<div class="mt-auto text-sm text-neutral">
    <div class="p-2 mx-2 flex flex-col gap-2 rounded-xl">
        <div class="flex items-center gap-2 select-none">
            <div class="w-8 h-8 rounded rounded-lg bg-neutral/10 flex justify-center items-center">
                <i class="fa-regular fa-user"></i>
            </div>
            <p>
                {{connectedUser.login}}
            </p>
        </div>
    </div>

    <ul class="menu p-2 gap-[1px]">
        <li>
            <a href="/dp-logout" class="hover:bg-neutral hover:border-neutral text-neutral hover:text-base-100 gap-2 px-3 py-2">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                {{__ "menu.logout"}}
            </a>
        </li>
    </ul>

    <p class="flex text-neutral-content text-xs pl-4 select-none">
        0.0.1-beta
    </p>
</div>
</aside>
