<aside class="hidden md:flex md:flex-col md:min-w-[208px] md:w-[208px] h-screen bg-base-100 p-2">
    <a href="/dashboard" class="flex justify-start items-center p-4 mb-2 cursor-pointer gap-2">
        <div class="w-[18px] select-none">
            <img src="/img/puna_short_logo.png" alt="Puna logo">
        </div>
        <h1 class="font-inter font-bold">
            Puna
            <sup class="text-neutral/50 italic text-xs font-medium">
                1.0.0
            </sup>
        </h1>
    </a>

    {{#roleIs roles='super_admin,owner'}}
        <div class="mt-auto text-sm text-neutral">
            <div class="px-4 py-2 pb-0 text-xs font-bold text-neutral-content uppercase tracking-wider select-none">
                {{__ "menu.menu"}}
            </div>
            <ul class="menu p-2 pb-0">
                <li>
                    <a href="/dashboard" class="rounded-md flex items-center gap-2 px-3 py-2 hover:bg-secondary-content/50">
                        <i class="fa-solid fa-display"></i>
                        {{__ "menu.app"}}
                    </a>
                </li>
            </ul>
        </div>
    {{/roleIs}}

    <!-- Menu Administration -->
    <nav class="flex-1">
        <div class="px-4 py-2 pb-0 text-xs font-bold text-neutral-content uppercase tracking-wider">
            {{__ "menu.administration"}}
        </div>
        <ul class="menu p-2">
            <li>
                <a href="/admin" class="hover:bg-secondary-content/50 rounded-md flex items-center gap-2 px-3 py-2">
                    <i class="fa-solid fa-chart-bar"></i>
                    {{__ "admin.overview"}}
                </a>
            </li>
            <li>
                <a href="/admin/users" class="hover:bg-secondary-content/50 rounded-md flex items-center gap-2 px-3 py-2">
                    <i class="fa-solid fa-users-line"></i>
                    {{__ "admin.users"}}
                </a>
            </li>
            {{#roleIs roles='super_admin'}}
                <li>
                    <a href="/admin/logs" class="hover:bg-secondary-content/50 rounded-md flex items-center gap-2 px-3 py-2">
                        <i class="fa-solid fa-list"></i>
                        {{__ "admin.logs"}}
                    </a>
                </li>
            {{/roleIs}}
        </ul>
    </nav>

    <!-- Bas du menu -->
    <div class="mt-auto text-sm text-neutral">
        <ul class="menu p-2">
            <li>
                <a href="/profile" class="hover:bg-secondary-content/50 text-neutral gap-2 px-3 py-2 rounded-md">
                    <i class="fa-regular fa-user"></i>
                    <p class="flex flex-col ml-1">
                        <span class="mt-[-4px]">
                            {{user.login}}
                        </span>
                        <span class="text-[0.5rem] leading-[0.5rem]">
                            {{__ "menu.my_account"}}
                        </span>
                    </p>
                </a>
            </li>
            <li>
                <a href="/dp-logout" class="hover:bg-red-700 hover:border-red-700 text-red-700 hover:text-base-100 gap-2 px-3 py-2 rounded-md">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    {{__ "menu.logout"}}
                </a>
            </li>
        </ul>
    </div>
</aside>

<script src="/js/left_menu.js" defer></script>
