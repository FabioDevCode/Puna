<aside class="hidden md:flex md:flex-col md:min-w-[208px] md:w-[208px] h-screen bg-base-100 p-2">
    <a href="/dashboard" class="flex justify-start items-center p-4 cursor-pointer gap-2">
        <div class="w-[24px] select-none">
            <img src="/img/puna_short_logo.png" alt="Puna logo">
        </div>
    </a>

    <nav class="flex-1">
        <div class="px-4 py-2 text-xs font-bold text-neutral-content uppercase tracking-wider select-none">
            {{__ "menu.app"}}
        </div>
        <ul class="menu p-2 gap-[1px] rounded-lg">
            <li>
                <a href="/dashboard"
                class="hover:bg-neutral hover:text-base-100 rounded-lg flex items-center gap-2 px-3 py-2">
                    <i class="fa-solid fa-chart-line"></i>
                    {{__ "menu.dashboard"}}
                </a>
            </li>
            <li>
                <a href="/site/all"
                class="hover:bg-neutral hover:text-base-100 rounded-lg flex items-center gap-2 px-3 py-2">
                    <i class="fa-solid fa-network-wired"></i>
                    {{__ "menu.website"}}
                </a>
            </li>
        </ul>
    </nav>

    {{#if show2FABanner}}
        <div class="col-span-2 md:col-span-6 lg:col-span-12">
            <div class="bg-secondary text-white shadow-lg rounded-2xl mb-4 p-2">
                <div class="flex flex-col items-left gap-2">
                    <span class="p-2">
                        <i class="fas fa-shield-alt"></i>
                        {{__ "twoFactor.banner_message"}}
                    </span>
                    <a href="/dp-2fa-setup" class="btn btn-sm shadow-sm">
                        {{__ "twoFactor.banner_setup"}}
                    </a>
                </div>
            </div>
        </div>
    {{/if}}

    <div class="mt-auto text-sm text-neutral">
        <ul class="menu p-2 gap-[1px]">
            {{#roleIs roles='super_admin,owner'}}
                <li>
                    <a href="/admin" class="hover:bg-neutral hover:text-base-100 rounded-lg flex items-center gap-2 px-3 py-2">
                        <i class="fa-solid fa-sliders"></i>
                        {{__ "menu.administration"}}
                    </a>
                </li>
            {{/roleIs}}

            <li>
                <a href="/profile" class="hover:bg-neutral hover:border-neutral text-neutral hover:text-base-100 gap-2 px-3 py-2">
                    <i class="fa-regular fa-user"></i>
                    {{__ "menu.my_account"}}
                </a>
            </li>

            <li>
                <a href="/dp-logout" class="hover:bg-neutral hover:border-neutral text-neutral hover:text-base-100 gap-2 px-3 py-2">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    {{__ "menu.logout"}}
                </a>
            </li>
        </ul>

        <p class="flex text-neutral/50 italic text-xs pl-5 select-none">
            1.0.0
        </p>
    </div>
</aside>

<script src="/js/left_menu.js" defer></script>
