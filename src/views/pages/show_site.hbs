<div class="flex flex-col items-start flex-wrap justify-center gap-6 py-2 h-max col-span-2 md:col-span-3 lg:col-span-6">
    <h3 class="font-inter col-12">
        {{site.domain}}
    </h3>

    <div class="flex flex-wrap gap-2 col-12">
        <a href="/dashboard" class="btn btn-sm btn-ghost-gray">
            <i class="fas fa-chevron-left"></i>
            Retour
        </a>
        {{> _ui/delete_site
            id=site.id
            domain=site.domain
        }}
        <button class="btn btn-sm btn-secondary">
            <i class="fas fa-plus"></i>
            Nouveau formulaire
        </button>
    </div>
</div>

<div class="flex items-start justify-start gap-2 py-2 h-max col-span-2 md:col-span-3 lg:col-span-6">
    info du formulaire
</div>

<div class="flex flex-col items-start justify-cneter gap-4 py-2 h-max col-span-2 md:col-span-6 lg:col-span-12">

    <div role="tablist" class="tabs tabs-lifted">
        <a role="tab" class="tab">page acceuil</a>
        <a role="tab" class="tab tab-active">contact</a>
        <a role="tab" class="tab">candidature</a>
    </div>

</div>