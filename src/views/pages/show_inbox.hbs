{{#slot "title"}}
<h3 class="font-inter truncate ellipsis-truncate title-max-w">
    #{{inbox.id}}
</h3>
{{/slot}}

{{#slot "buttons"}}
<a href="/site/{{site.id}}?f={{form.name}}" class="btn btn-sm btn-outline">
    <i class="fa-solid fa-arrow-left"></i>
    <span class="hidden md:flex">
        Retour
    </span>
</a>

<button class="btn btn-sm btn-error btn-outline" id="btn_delete_inbox_show">
    <i class="fa-regular fa-trash-can"></i>
    <span class="hidden md:flex">
        Supprimer
    </span>
</button>
{{/slot}}

<div class="flex flex-col gap-4 col-span-2 md:col-span-6 lg:col-span-12 overflow-hidden">
    <div class="card bg-base-100 shadow-xl">
        <div class="card-body p-4 overflow-hidden">
            <h2 class="card-title">Informations générales</h2>
            <div id="{{inbox.id}}" class="flex flex-wrap items-center gap-4">
                <div>
                    <p class="text-sm text-muted">Site</p>
                    <p class="font-semibold">{{site.domain}}</p>
                </div>
                <div class="divider divider-horizontal mx-0"></div>
                <div>
                    <p class="text-sm text-muted">Formulaire</p>
                    <p class="font-semibold">{{form.name}}</p>
                </div>
                <div class="divider divider-horizontal mx-0"></div>
                <div>
                    <p class="text-sm text-muted">Date de réception</p>
                    <p class="font-semibold">{{formattedDate}}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
        <div class="card-body p-4 overflow-hidden">
            <h2 class="card-title">Données du formulaire</h2>
            {{#if contentEntries}}
            <div class="overflow-x-auto">
                <table class="table w-full">
                    <thead>
                        <tr>
                            <th>Champ</th>
                            <th>Valeur</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each contentEntries}}
                        <tr>
                            <td class="font-semibold">{{this.label}}</td>
                            <td>
                                <div class="whitespace-pre-wrap break-words">{{this.value}}</div>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{else}}
            <p class="text-sm text-muted">Aucune donnée disponible</p>
            {{/if}}
        </div>
    </div>

    {{#if fileEntries}}
    <div class="card bg-base-100 shadow-xl select-none">
        <div class="card-body p-4 overflow-hidden">
            <div class="flex items-center justify-between mb-2">
                <h2 class="card-title">
                    Documents reçus
                </h2>
                <button id="btn_download_zip" class="btn btn-sm btn-neutral">
                    <i class="fa-solid fa-file-zipper"></i>
                    <span class="hidden md:inline">Télécharger tout</span>
                </button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {{#each fileEntries}}
                <a href="/inbox/{{../inbox.id}}/download/{{this.filename}}"
                    class="flex items-center gap-3 p-4 rounded-lg border border-base-300 bg-base-200 hover:bg-base-300 transition-colors cursor-pointer">
                    <div class="flex-shrink-0">
                        <div class="w-12 h-12 rounded-lg bg-[{{this.bg_color}}] flex items-center justify-center">
                            <i class="{{this.icon}} text-3xl text-{{this.color}}"></i>
                        </div>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="badge bg-[{{this.bg_color}}] text-{{this.color}} text-[10px] badge-sm">
                                {{this.label}}
                            </span>
                        </div>
                        <p class="text-sm font-medium text-base-content truncate" title="{{this.filename}}">
                            {{this.original_filename}}
                        </p>
                        <p class="text-xs text-muted mt-1">
                            Champ : {{this.template}}
                        </p>
                    </div>
                </a>
                {{/each}}
            </div>
        </div>
    </div>
    {{/if}}
</div>

{{> _ui/delete_inbox_show
inbox_id=inbox.id
form_name=form.name
site_id=site.id
}}

<!-- Modal de téléchargement ZIP -->
<dialog id="modal_downloading_zip" class="modal">
    <div class="modal-box w-11/12 md:w-4/12 lg:w-3/12 text-center">
        <h3 class="font-bold text-lg mb-4">Préparation du téléchargement</h3>
        <div class="flex justify-center mb-4">
            <span class="loading loading-spinner loading-lg text-primary"></span>
        </div>
        <p class="text-sm text-muted">
            Veuillez patienter pendant la création de l'archive ZIP...
        </p>
    </div>
</dialog>

<script>
    (function () {
        try {
            const btnDownloadZip = document.getElementById('btn_download_zip');
            const modal = document.getElementById('modal_downloading_zip');

            if (btnDownloadZip && modal) {
                btnDownloadZip.addEventListener('click', async (e) => {
                    e.preventDefault();

                    // Show loading modal
                    try {
                        modal.showModal();
                    } catch (err) {
                        console.error('Error showing modal:', err);
                    }

                    // Create a hidden iframe to trigger download
                    const iframe = document.createElement('iframe');
                    iframe.style.display = 'none';
                    iframe.src = '/inbox/{{inbox.id}}/download-zip';
                    document.body.appendChild(iframe);

                    // Close modal after a delay (the download should have started)
                    setTimeout(() => {
                        try {
                            modal.close();
                            document.body.removeChild(iframe);
                        } catch (err) {
                            console.error('Error closing modal:', err);
                        }
                    }, 2000);
                });
            }
        } catch (e) {
            console.error('Script error:', e);
        }
    })();
</script>