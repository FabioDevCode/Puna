{{#slot "title"}}
<h3 class="font-inter truncate ellipsis-truncate title-max-w">
    Inbox
    {{!-- #{{inbox.id}} --}}
</h3>
{{/slot}}

{{#slot "buttons"}}
<a href="/site/{{site.id}}?f={{form.name}}" class="btn btn-sm btn-outline">
    <i class="fa-solid fa-arrow-left"></i>
    <span class="hidden md:flex">
        Retour
    </span>
</a>

<button class="btn btn-sm btn-error btn-outline" id="btn_delete_inbox_show">
    <i class="fa-regular fa-trash-can"></i>
    <span class="hidden md:flex">
        Supprimer
    </span>
</button>
{{/slot}}

<div class="flex flex-col gap-4 col-span-2 md:col-span-6 lg:col-span-12 overflow-hidden">
    <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
            <h2 class="card-title">Informations générales</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <p class="text-sm text-muted">ID</p>
                    <p class="font-semibold">{{inbox.id}}</p>
                </div>
                <div>
                    <p class="text-sm text-muted">Date de réception</p>
                    <p class="font-semibold">{{formattedDate}}</p>
                </div>
                <div>
                    <p class="text-sm text-muted">Site</p>
                    <p class="font-semibold">{{site.domain}}</p>
                </div>
                <div>
                    <p class="text-sm text-muted">Formulaire</p>
                    <p class="font-semibold">{{form.name}}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
            <h2 class="card-title">Données du formulaire</h2>
            {{#if contentEntries}}
            <div class="overflow-x-auto">
                <table class="table w-full">
                    <thead>
                        <tr>
                            <th>Champ</th>
                            <th>Valeur</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each contentEntries}}
                        <tr>
                            <td class="font-semibold">{{this.label}}</td>
                            <td>
                                <div class="whitespace-pre-wrap break-words">{{this.value}}</div>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{else}}
            <p class="text-sm text-muted">Aucune donnée disponible</p>
            {{/if}}
        </div>
    </div>

    {{#if fileEntries}}
    <div class="card bg-base-100 shadow-xl select-none">
        <div class="card-body">
            <h2 class="card-title">Documents</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {{#each fileEntries}}
                <div
                    class="flex items-center gap-3 p-4 rounded-lg border border-base-300 bg-base-200 hover:bg-base-300 transition-colors">
                    <div class="flex-shrink-0">
                        <div class="w-12 h-12 rounded-lg bg-[{{this.bg_color}}] flex items-center justify-center">
                            <i class="{{this.icon}} text-3xl text-{{this.color}}"></i>
                        </div>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="badge bg-[{{this.bg_color}}] text-{{this.color}} text-[10px] badge-sm">
                                {{this.label}}
                            </span>
                        </div>
                        <p class="text-sm font-medium text-base-content truncate" title="{{this.filename}}">
                            {{this.filename}}
                        </p>
                        <p class="text-xs text-muted mt-1">
                            Champ : {{this.template}}
                        </p>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
    </div>
    {{/if}}
</div>

<!-- Modal de suppression d'inbox -->
<dialog id="modal_delete_inbox_show" class="modal">
    <div class="modal-box w-11/12 md:w-6/12 lg:w-5/12">
        <h3 class="font-bold text-lg">Confirmer la suppression</h3>
        <p class="py-4">Êtes-vous sûr de vouloir supprimer cette entrée inbox ? Cette action est irréversible.</p>

        <form id="formDeleteInboxShow" action="/inbox/{{inbox.id}}/delete?redirect=site&formName={{form.name}}"
            method="post" class="hidden">
            <input type="hidden" name="inbox_id" value="{{inbox.id}}" />
        </form>

        <div class="modal-action mt-2">
            <form method="dialog">
                <button class="btn btn-sm">Annuler</button>
            </form>
            <button type="submit" form="formDeleteInboxShow" class="btn btn-sm btn-error">Supprimer</button>
        </div>
    </div>
</dialog>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const btnDelete = document.getElementById('btn_delete_inbox_show');
        const modal = document.getElementById('modal_delete_inbox_show');

        if (btnDelete && modal) {
            btnDelete.addEventListener('click', (e) => {
                e.preventDefault();
                try {
                    modal.showModal();
                } catch (err) {
                    console.error(err);
                }
            });
        }
    });
</script>