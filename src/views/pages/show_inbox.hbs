{{#slot "title"}}
<h3 class="font-inter truncate ellipsis-truncate title-max-w">
    #{{inbox.id}}
</h3>
{{/slot}}

{{#slot "buttons"}}
<a href="/site/{{site.id}}?f={{form.name}}" class="btn btn-sm btn-outline">
    <i class="fa-solid fa-arrow-left"></i>
    <span class="hidden md:flex">
        Retour
    </span>
</a>

<button class="btn btn-sm btn-error btn-outline" id="btn_delete_inbox_show">
    <i class="fa-regular fa-trash-can"></i>
    <span class="hidden md:flex">
        Supprimer
    </span>
</button>
{{/slot}}

<div class="flex flex-col gap-4 col-span-2 md:col-span-6 lg:col-span-12 overflow-hidden">
    <div class="card bg-base-100 shadow-xl">
        <div class="card-body p-4 overflow-hidden">
            <h2 class="card-title">Informations générales</h2>
            <div id="{{inbox.id}}" class="flex flex-wrap items-center gap-4">
                <div>
                    <p class="text-sm text-muted">Site</p>
                    <p class="font-semibold">{{site.domain}}</p>
                </div>
                <div class="divider divider-horizontal mx-0"></div>
                <div>
                    <p class="text-sm text-muted">Formulaire</p>
                    <p class="font-semibold">{{form.name}}</p>
                </div>
                <div class="divider divider-horizontal mx-0"></div>
                <div>
                    <p class="text-sm text-muted">Date de réception</p>
                    <p class="font-semibold">{{formattedDate}}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
        <div class="card-body p-4 overflow-hidden">
            <h2 class="card-title">Données du formulaire</h2>
            {{#if contentEntries}}
            <div class="overflow-x-auto">
                <table class="table w-full">
                    <thead>
                        <tr>
                            <th>Champ</th>
                            <th>Valeur</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each contentEntries}}
                        <tr>
                            <td class="font-semibold">{{this.label}}</td>
                            <td>
                                <div class="whitespace-pre-wrap break-words">{{this.value}}</div>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{else}}
            <p class="text-sm text-muted">Aucune donnée disponible</p>
            {{/if}}
        </div>
    </div>

    {{#if fileEntries}}
    <div class="card bg-base-100 shadow-xl select-none">
        <div class="card-body p-4 overflow-hidden">
            <div class="flex items-center justify-between mb-2">
                <h2 class="card-title">
                    Documents reçus
                </h2>
                {{> _ui/btn_download_all_files inbox_id=inbox.id}}
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {{#each fileEntries}}
                <a href="/inbox/{{../inbox.id}}/download/{{this.filename}}" data-download-link
                    class="download-card relative flex items-center gap-3 p-4 rounded-lg border border-base-300 bg-base-200 hover:bg-base-300 hover:shadow-md hover:border-primary/30 transition-all duration-200 cursor-pointer group">
                    <div class="flex-shrink-0">
                        <div class="w-12 h-12 rounded-lg bg-[{{this.bg_color}}] flex items-center justify-center">
                            <i class="{{this.icon}} text-3xl text-{{this.color}}"></i>
                        </div>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="badge bg-[{{this.bg_color}}] text-{{this.color}} text-[10px] badge-sm">
                                {{this.label}}
                            </span>
                        </div>
                        <p class="text-sm font-medium text-base-content truncate" title="{{this.filename}}">
                            {{this.original_filename}}
                        </p>
                        <p class="text-xs text-muted mt-1">
                            Champ : {{this.template}}
                        </p>
                    </div>

                    <!-- Download badge (visible on hover) -->
                    <div
                        class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none">
                        <div
                            class="flex items-center gap-1 bg-neutral text-neutral-content px-2 py-1 rounded-full shadow-lg text-xs font-medium">
                            <i class="fa-solid fa-download text-xs"></i>
                            <span>Télécharger</span>
                        </div>
                    </div>

                    <!-- Download indicator (hidden by default, shown on click) -->
                    <div
                        class="download-indicator absolute inset-0 bg-success/20 rounded-lg flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
                        <div
                            class="bg-success text-white rounded-full aspect-square w-10 h-10 flex items-center justify-center shadow-lg transform scale-0 transition-transform duration-300">
                            <i class="fa-solid fa-download text-xl"></i>
                        </div>
                    </div>
                </a>
                {{/each}}
            </div>
        </div>
    </div>
    {{/if}}
</div>

{{> _ui/delete_inbox_show
inbox_id=inbox.id
form_name=form.name
site_id=site.id
}}