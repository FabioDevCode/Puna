{{#slot "title"}}
    <h3 class="font-inter">{{__ "admin.settings_title"}}</h3>
{{/slot}}

<!-- Card: Paramètres -->
<div class="col-span-2 md:col-span-6 lg:col-span-12">
    <div class="card bg-base-100 shadow-md">
        <div class="card-body">
            <div class="alert alert-info">
                <i class="fa-solid fa-info-circle"></i>
                <span>{{__ "admin.settings_wip_message"}}</span>
            </div>

            <!-- Placeholder pour les futurs paramètres -->
            <div class="grid grid-cols-1 gap-6 mt-6">
                <div class="divider">{{__ "admin.settings_general"}}</div>

                <p class="text-neutral-content text-center py-8">
                    {{__ "admin.settings_placeholder"}}
                </p>
            </div>
        </div>
    </div>
</div>
