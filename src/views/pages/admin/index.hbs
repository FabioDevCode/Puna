{{#slot "title"}}
    <h3 class="font-inter">
        {{__ "admin.overview_title"}}
    </h3>
{{/slot}}

<!-- Statistiques rapides -->
<div class="col-span-2 md:col-span-3 lg:col-span-3">
    <div class="stats shadow-xl w-full rounded-lg">
        <div class="stat">
            <div class="stat-figure text-neutral">
                <i class="fa-solid fa-users text-3xl"></i>
            </div>
            <div class="stat-title">{{__ "admin.stats_users"}}</div>
            <div class="stat-value text-neutral">{{stats.users}}</div>
            <div class="stat-desc">{{__ "admin.stats_total"}}</div>
        </div>
    </div>
</div>

<div class="col-span-2 md:col-span-3 lg:col-span-3">
    <div class="stats shadow-xl w-full rounded-lg">
        <div class="stat">
            <div class="stat-figure text-neutral">
                <i class="fa-solid fa-globe text-3xl"></i>
            </div>
            <div class="stat-title">{{__ "admin.stats_sites"}}</div>
            <div class="stat-value text-neutral">{{stats.sites}}</div>
            <div class="stat-desc">{{__ "admin.stats_total"}}</div>
        </div>
    </div>
</div>

<div class="col-span-2 md:col-span-3 lg:col-span-3">
    <div class="stats shadow-xl w-full rounded-lg">
        <div class="stat">
            <div class="stat-figure text-neutral">
                <i class="fa-solid fa-file-lines text-3xl"></i>
            </div>
            <div class="stat-title">{{__ "admin.stats_forms"}}</div>
            <div class="stat-value text-neutral">{{stats.forms}}</div>
            <div class="stat-desc">{{__ "admin.stats_total"}}</div>
        </div>
    </div>
</div>

<div class="col-span-2 md:col-span-3 lg:col-span-3">
    <div class="stats shadow-xl w-full rounded-lg">
        <div class="stat">
            <div class="stat-figure text-neutral">
                <i class="fa-solid fa-inbox text-3xl"></i>
            </div>
            <div class="stat-title">{{__ "admin.stats_entries"}}</div>
            <div class="stat-value text-neutral">{{stats.entries}}</div>
            <div class="stat-desc">{{__ "admin.stats_total"}}</div>
        </div>
    </div>
</div>

<!-- Statistiques d'activité -->
<div class="col-span-2 md:col-span-3 {{#if showMcpStats}}lg:col-span-4{{else}}lg:col-span-6{{/if}}">
    <div class="stats shadow-xl w-full rounded-lg">
        <div class="stat">
            <div class="stat-figure text-success">
                <i class="fa-solid fa-circle text-sm animate-pulse"></i>
            </div>
            <div class="stat-title">{{__ "admin.stats_online"}}</div>
            <div class="stat-value text-success">{{activityStats.connectedUsers}}</div>
            <div class="stat-desc">{{__ "admin.stats_connected_users"}}</div>
        </div>
    </div>
</div>

{{#if showMcpStats}}
    <div class="col-span-2 md:col-span-3 lg:col-span-4">
        <div class="stats shadow-xl w-full rounded-lg">
            <div class="stat">
                <div class="stat-figure text-violet-500">
                    <i class="fa-solid fa-key text-3xl"></i>
                </div>
                <div class="stat-title">{{__ "admin.stats_mcp_keys"}}</div>
                <div class="stat-value text-violet-500">{{activityStats.mcpKeys}}</div>
                <div class="stat-desc">{{__ "admin.stats_mcp_keys_desc"}}</div>
            </div>
        </div>
    </div>
{{/if}}

<div class="col-span-2 md:col-span-3 {{#if showMcpStats}}lg:col-span-4{{else}}lg:col-span-6{{/if}}">
    <div class="stats shadow-xl w-full rounded-lg">
        <div class="stat">
            <div class="stat-figure text-error">
                <i class="fa-solid fa-triangle-exclamation text-3xl"></i>
            </div>
            <div class="stat-title">{{__ "admin.stats_errors"}}</div>
            <div class="stat-value text-error">{{activityStats.errorsCount}}</div>
            <div class="stat-desc">{{__ "admin.stats_logs"}}</div>
        </div>
    </div>
</div>

<div class="col-span-2 md:col-span-3 lg:col-span-6">
    <div class="stats shadow-xl w-full rounded-lg">
        <div class="stat">
            <div class="stat-figure text-info">
                <i class="fa-regular fa-calendar-plus text-3xl"></i>
            </div>
            <div class="stat-title">{{__ "admin.stats_created_today"}}</div>
            <div class="stat-value text-info">{{activityStats.todaySites}} / {{activityStats.todayForms}}</div>
            <div class="stat-desc">{{__ "admin.stats_sites_forms"}}</div>
        </div>
    </div>
</div>

<div class="col-span-2 md:col-span-3 lg:col-span-6">
    <div class="stats shadow-xl w-full rounded-lg">
        <div class="stat">
            <div class="stat-figure text-warning">
                <i class="fa-regular fa-folder-open text-3xl"></i>
            </div>
            <div class="stat-title">{{__ "admin.stats_files"}}</div>
            <div class="stat-value text-warning">{{activityStats.totalFiles}}</div>
            <div class="stat-desc">{{__ "admin.stats_total_uploaded"}}</div>
        </div>
    </div>
</div>
