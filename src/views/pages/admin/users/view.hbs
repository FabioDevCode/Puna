{{#slot "title"}}
    <div class="flex items-center gap-4">
        <a href="/admin/users" class="btn btn-outline btn-sm">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h3 class="font-inter">{{__ "admin.user_view_title"}}</h3>
    </div>
{{/slot}}

{{#slot "buttons"}}
    {{#roleIs roles='super_admin'}}
        {{#actionCan entity='user' action='update'}}
            {{#unless (eq user.status "anonymized")}}
                <a href="/admin/users/{{user.id}}/edit" class="btn btn-sm btn-warning">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span class="hidden md:flex">
                        {{__ "admin.user_btn_edit"}}
                    </span>
                </a>
            {{/unless}}
        {{/actionCan}}
    {{/roleIs}}
    {{#roleIs roles='owner'}}
        {{#unless (eq user.role "super_admin")}}
            {{#actionCan entity='user' action='update'}}
                {{#unless (eq user.status "anonymized")}}
                    <a href="/admin/users/{{user.id}}/edit" class="btn btn-sm btn-warning">
                        <i class="fa-solid fa-pen-to-square"></i>
                        <span class="hidden md:flex">
                            {{__ "admin.user_btn_edit"}}
                        </span>
                    </a>
                {{/unless}}
            {{/actionCan}}
        {{/unless}}
    {{/roleIs}}

    {{#roleIs roles='super_admin'}}
        {{#actionCan entity='user' action='delete'}}
            <button id="deleteUserBtn" class="btn btn-sm btn-error btn-outline"
            data-user-id="{{user.id}}" data-user-login="{{user.login}}">
                <i class="far fa-trash-alt"></i>
                <span class="hidden md:flex">
                    {{__ "admin.user_btn_delete"}}
                </span>
            </button>
        {{/actionCan}}
    {{/roleIs}}
{{/slot}}

<div class="col-span-2 md:col-span-6 lg:col-span-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 animate-fade-in">
        {{#roleIs roles='super_admin'}}
            {{#unless (eq user.status "anonymized")}}
                <div id="status_btn_box" class="card bg-base-100 shadow-xl col-span-1 lg:col-span-3 rounded-xl">
                    {{> components/buttons/user-status-actions }}
                </div>
            {{/unless}}
        {{/roleIs}}
        {{#roleIs roles='owner'}}
            {{#unless (eq user.role "super_admin")}}
                {{#unless (eq user.status "anonymized")}}
                    <div id="status_btn_box" class="card bg-base-100 shadow-xl col-span-1 lg:col-span-3 rounded-xl">
                        {{> components/buttons/user-status-actions }}
                    </div>
                {{/unless}}
            {{/unless}}
        {{/roleIs}}

        <!-- Colonne gauche: Profil résumé -->
        <div class="col-span-1">
            <div class="card bg-base-100 shadow-xl rounded-xl">
                <div class="card-body items-center text-center p-6">
                    <h2 class="card-title text-2xl font-bold mb-1">
                        {{user.login}}
                    </h2>

                    <p class="text-base-content/60 font-medium mb-3">
                        {{#if user.email}}
                            {{user.email}}
                        {{else}}
                            <span class="italic text-base-content/40">
                                &nbsp;
                            </span>
                        {{/if}}
                    </p>

                    <div class="flex gap-2 justify-center mb-6">
                        <span class="badge badge-outline badge_role badge_{{user.role}} badge-lg">
                            {{user.role}}
                        </span>

                        <span class="badge_s_{{user.status}} profil_badge">
                            {{user.status}}
                        </span>
                    </div>

                    <div class="w-full border-t border-base-200 my-2"></div>

                    <div class="w-full flex justify-between items-center text-sm mt-3">
                        <span class="text-base-content/50 font-medium">
                            {{__ "admin.user_last_connection"}}
                        </span>
                        <span class="font-semibold text-base-content/80">
                            {{#if user.last_connection}}
                                {{user.last_connection}}
                            {{else}}
                                <span class="italic text-base-content/40">
                                    {{__ "admin.user_never"}}
                                </span>
                            {{/if}}
                        </span>
                    </div>
                    <div class="w-full flex justify-between items-center text-sm mt-3">
                        <span class="text-base-content/50 font-medium">
                            {{__ "admin.user_creation"}}
                        </span>
                        <span class="font-semibold text-base-content/80">
                            {{user.createdAt}}
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Colonne droite: Détails -->
        <div class="col-span-1 lg:col-span-2 space-y-6">
            <!-- Informations détaillées -->
            <div class="card bg-base-100 shadow-xl rounded-xl">
                <div class="card-body p-6">
                    <h3 class="text-lg font-bold border-b border-base-200 pb-3 mb-5 flex items-center gap-2">
                        {{__ "admin.user_account_info"}}
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8">
                        <div class="group">
                            <span class="block text-[11px] font-bold text-base-content/50 uppercase tracking-widest mb-2">
                                {{__ "admin.user_label_login"}}
                            </span>
                            <div class="bg-base-200/50 group-hover:bg-base-200/80 transition-colors rounded-lg px-4 py-3.5 font-semibold text-base-content text-sm border border-base-200">
                                {{user.login}}
                            </div>
                        </div>
                        <div class="group">
                            <span class="block text-[11px] font-bold text-base-content/50 uppercase tracking-widest mb-2">
                                {{__ "admin.user_label_email"}}
                            </span>
                            <div class="bg-base-200/50 group-hover:bg-base-200/80 transition-colors rounded-lg px-4 py-3.5 font-semibold text-base-content text-sm border border-base-200">
                                {{#if user.email}}
                                    {{user.email}}
                                {{else}}
                                    &nbsp;
                                {{/if}}
                            </div>
                        </div>
                        <div class="group">
                            <span class="block text-[11px] font-bold text-base-content/50 uppercase tracking-widest mb-2">
                                {{__ "admin.user_label_role"}}
                            </span>
                            <div class="bg-base-200/50 group-hover:bg-base-200/80 transition-colors rounded-lg px-4 py-3.5 font-semibold text-base-content text-sm border border-base-200 flex items-center gap-2">
                                {{user.role}}
                            </div>
                        </div>
                        <div class="group">
                            <span class="block text-[11px] font-bold text-base-content/50 uppercase tracking-widest mb-2">
                                {{__ "admin.user_label_created_by"}}
                            </span>
                            <div class="bg-base-200/50 group-hover:bg-base-200/80 transition-colors rounded-lg px-4 py-3.5 font-semibold text-base-content text-sm border border-base-200 flex items-center gap-2">
                                {{#if user.creator}}
                                    {{user.creator.login}}
                                {{else}}
                                    <span class="italic text-base-content/40">{{__ "admin.user_system"}}</span>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sites assignés -->
        <div class="card bg-base-100 shadow-xl col-span-1 lg:col-span-2 rounded-xl">
            <div class="card-body p-6">
                <h3 class="text-lg font-bold border-b border-base-200 pb-3 mb-5 flex items-center gap-2">
                    {{__ "admin.user_assigned_sites"}}
                </h3>

                {{#if (eq user.role "super_admin")}}
                    <div class="flex flex-col items-center justify-center p-6 bg-neutral/10 rounded-lg border border-neutral">
                        <p class="text-neutral text-md font-medium text-center">
                            {{{__ "admin.user_superadmin_all_sites"}}}
                        </p>
                    </div>
                {{else}}
                    {{#if user.siteassignments}}
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-2 gap-4">
                            {{#each user.siteassignments}}
                                <div class="flex items-center gap-4 bg-base-200/80 p-3.5 rounded-lg border border-base-200 cursor-default">
                                    <div class="bg-base-100 shadow-sm w-8 h-8 rounded-md flex items-center justify-center text-neutral text-sm">
                                        <i class="fa-solid fa-network-wired"></i>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="font-bold text-sm text-base-content truncate">
                                            {{this.site.domain}}
                                        </p>
                                    </div>
                                </div>
                            {{/each}}
                        </div>
                    {{else}}
                        <div class="flex flex-col items-center justify-center py-10 px-4 bg-base-200/30 rounded-lg border-2 border-dashed border-base-300">
                            <div class="bg-base-200 text-base-content/30 w-16 h-16 rounded-full flex items-center justify-center mb-4 text-3xl">
                                <i class="fa-solid fa-link-slash"></i>
                            </div>
                            <h4 class="text-base-content/80 font-bold mb-1">
                                {{__ "admin.user_no_assigned_sites"}}
                            </h4>
                            <p class="text-base-content/50 text-sm font-medium text-center">
                                {{__ "admin.user_no_sites_desc"}}
                            </p>
                        </div>
                    {{/if}}
                {{/if}}
            </div>
        </div>

        {{#if showMcpAdmin}}
            <!-- Accès MCP -->
            <div class="card bg-base-100 shadow-xl col-span-1 lg:col-span-1 rounded-xl">
                <div class="card-body p-6">
                    <h3 class="text-lg font-bold border-b border-base-200 pb-3 mb-2 flex items-center gap-2">
                        {{__ "admin.user_mcp_access_title"}}
                    </h3>
                    <div class="flex items-center gap-3 ">
                        {{#if user.mcp_enabled}}
                            {{!-- <input type="checkbox" checked="checked" class="checkbox checkbox-secondary disabled" /> --}}
                            <input type="checkbox" class="toggle toggle-secondary disabled" checked="checked" />
                        <span class="text-sm text-base-content/60">{{__ "admin.user_mcp_access_enabled"}}</span>
                    {{else}}
                        <input type="checkbox" class="toggle toggle-secondary disabled" />
                    <span class="text-sm text-base-content/60">{{__ "admin.user_mcp_access_disabled"}}</span>
                {{/if}}
            </div>
        </div>
    </div>
{{/if}}
</div>
</div>

{{> components/modals/delete-user }}
{{> components/modals/ban-user }}

<script src="/js/admin/user-view.js"></script>
