{{#slot "title"}}
    <div class="flex items-center gap-4">
        <a href="/admin/users" class="btn btn-outline btn-sm">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h3 class="font-inter">{{__ "admin.user_edit_title"}}</h3>
    </div>
{{/slot}}

<!-- Card: Édition utilisateur -->
<div class="col-span-2 md:col-span-6 lg:col-span-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 animate-fade-in">
        <!-- Colonne gauche: Profil résumé -->
        <div class="col-span-1">
            <div class="card bg-base-100 shadow-xl border border-base-200 rounded-xl">
                <div class="card-body items-center text-center p-6">
                    <h2 class="card-title text-2xl font-bold mb-1">
                        {{user.login}}
                    </h2>

                    <p class="text-base-content/60 font-medium mb-3">
                        {{#if user.email}}
                            {{user.email}}
                        {{else}}
                            <span class="italic text-base-content/40">
                                &nbsp;
                            </span>
                        {{/if}}
                    </p>

                    <div class="flex gap-2 justify-center mb-6">
                        <span class="badge badge-outline badge_role badge_{{user.role}} badge-lg">
                            {{user.role}}
                        </span>

                        <span class="badge_s_{{user.status}} profil_badge">
                            {{user.status}}
                        </span>
                    </div>

                    <div class="w-full border-t border-base-200 my-2"></div>

                    <div class="w-full flex justify-between items-center text-sm mt-3">
                        <span class="text-base-content/50 font-medium">
                            {{__ "admin.user_last_connection"}}
                        </span>
                        <span class="font-semibold text-base-content/80">
                            {{#if user.last_connection}}
                                {{user.last_connection}}
                            {{else}}
                                <span class="italic text-base-content/40">
                                    {{__ "admin.user_never"}}
                                </span>
                            {{/if}}
                        </span>
                    </div>
                    <div class="w-full flex justify-between items-center text-sm mt-3">
                        <span class="text-base-content/50 font-medium">
                            {{__ "admin.user_creation"}}
                        </span>
                        <span class="font-semibold text-base-content/80">
                            {{user.createdAt}}
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Colonne droite: Détails -->
        <div class="col-span-1 lg:col-span-2 space-y-6">
            <!-- Informations détaillées -->
            <div class="card bg-base-100 shadow-xl border border-base-200 rounded-xl">
                <div class="card-body p-6">
                    <h3 class="text-lg font-bold border-b border-base-200 pb-3 mb-5 flex items-center gap-2">
                        {{__ "admin.user_account_info"}}
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8">
                        <div class="group">
                            <span class="block text-[11px] font-bold text-base-content/50 uppercase tracking-widest mb-2">
                                {{__ "admin.user_label_login"}}
                            </span>
                            <div class="bg-base-200/50 group-hover:bg-base-200/80 transition-colors rounded-lg px-4 py-3.5 font-semibold text-base-content text-sm border border-base-200">
                                {{user.login}}
                            </div>
                        </div>
                        <div class="group">
                            <span class="block text-[11px] font-bold text-base-content/50 uppercase tracking-widest mb-2">
                                {{__ "admin.user_label_email"}}
                            </span>
                            <div class="bg-base-200/50 group-hover:bg-base-200/80 transition-colors rounded-lg px-4 py-3.5 font-semibold text-base-content text-sm border border-base-200">
                                {{#if user.email}}
                                    {{user.email}}
                                {{else}}
                                    &nbsp;
                                {{/if}}
                            </div>
                        </div>
                        <div class="group">
                            <span class="block text-[11px] font-bold text-base-content/50 uppercase tracking-widest mb-2">
                                {{__ "admin.user_label_role"}}
                            </span>
                            <div class="bg-base-200/50 group-hover:bg-base-200/80 transition-colors rounded-lg px-4 py-3.5 font-semibold text-base-content text-sm border border-base-200 flex items-center gap-2">
                                {{user.role}}
                            </div>
                        </div>
                        <div class="group">
                            <span class="block text-[11px] font-bold text-base-content/50 uppercase tracking-widest mb-2">
                                {{__ "admin.user_label_created_by"}}
                            </span>
                            <div class="bg-base-200/50 group-hover:bg-base-200/80 transition-colors rounded-lg px-4 py-3.5 font-semibold text-base-content text-sm border border-base-200 flex items-center gap-2">
                                {{#if user.creator}}
                                    {{user.creator.login}}
                                {{else}}
                                    <span class="italic text-base-content/40">{{__ "admin.user_system"}}</span>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sites assignés -->
        <div class="card bg-base-100 shadow-xl border border-base-200 col-span-1 lg:col-span-3 rounded-xl">
            <div class="card-body p-6">
                <form action="/admin/users/{{user.id}}/update" method="POST" class="flex flex-col gap-0">
                    <input type="hidden" name="_csrf" value="{{csrfToken}}" />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                    <!-- Sites assignés -->
                    <div class="form-control w-full md:col-span-2">
                        <label class="label p-0 mb-5">
                            <h3 class="text-lg font-bold border-b border-base-200 pb-3 flex items-center gap-2">
                                {{__ "admin.user_assigned_sites"}}
                            </h3>
                        </label>

                        <!-- Recherche de sites -->
                        <div class="relative mb-2">
                            <input type="text" id="siteSearchInput" placeholder="{{__ "admin.user_filter_sites_placeholder"}}" class="input input-md input-bordered w-full pl-8">
                            <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-neutral-content text-xs"></i>
                        </div>

                        <!-- Liste des sites (Checkboxes) -->
                        <div id="sitesListContainer"  class="border border-base-300 rounded-lg h-48 overflow-y-auto bg-base-100 p-1">
                            {{#each sites}}
                                <label
                                class="cursor-pointer label hover:bg-base-200 rounded-md px-3 py-2 transition-colors justify-start gap-3">
                                    <input type="checkbox" name="sites" value="{{this.id}}"
                                    class="checkbox checkbox-sm checkbox-neutral rounded-md site-checkbox" {{#if
                                    this.isAssigned}}checked{{/if}} />
                                    <span class="label-text flex-1 truncate" title="{{this.domain}}">{{this.domain}}</span>
                                </label>
                            {{else}}
                                <div class="text-center text-neutral text-sm p-8 flex flex-col items-center gap-2">
                                    <i class="fa-solid fa-globe text-2xl opacity-20"></i>
                                    <span>{{__ "admin.user_no_sites_available"}}</span>
                                </div>
                            {{/each}}

                            <!-- Message aucun résultat recherche -->
                            <div id="noSiteFound" class="hidden text-center text-neutral text-sm p-4">
                                {{__ "admin.user_no_site_match"}}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex justify-end gap-2 mt-4">
                    <a href="/admin/users/{{user.id}}/view" class="btn btn-sm">
                        {{__ "btn.cancel"}}
                    </a>
                    <button type="submit" class="btn btn-sm btn-secondary">
                        <i class="fa-solid fa-save"></i>
                        {{__ "btn.save"}}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
</div>

<script src="/js/admin_user_edit.js"></script>
