{{#slot "title"}}
    <div class="flex items-center gap-4">
        <h3 class="font-inter">{{__ "admin.users_title"}}</h3>
    </div>
{{/slot}}

{{#slot "buttons"}}

    {{#roleIs roles='super_admin,owner'}}
        {{#actionCan entity='user' action='create'}}
            <button id="btn-create-user" class="btn btn-sm btn-secondary gap-2">
                <i class="fa-solid fa-plus"></i>
                <span class="hidden md:flex">
                    {{__ "admin.users_new"}}
                </span>
            </button>
        {{/actionCan}}
    {{/roleIs}}

{{/slot}}


<!-- Card: Liste des utilisateurs -->
<div class="h-full col-span-2 md:col-span-6 lg:col-span-12">
    <div class="card h-full bg-base-100 shadow-md rounded-lg border border-base-300">
        <div id="userContainer" class="card-body h-full p-4 overflow-hidden">
            <!-- Actions de la table -->
            <div id="tableActions">
                <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                    <div class="flex items-center gap-2">
                        <!-- Sélecteur de nombre de lignes et compteur -->
                        <select id="numLignTable" class="select select-sm select-bordered w-max">
                            <option value="10" selected>10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <div id="count_users" class="text-sm min-w-[102px] select-none"></div>
                    </div>

                    <!-- Pagination -->
                    <div id="paginationTable" class="join">
                        <button id="prevPage" class="join-item btn btn-sm">«</button>
                        <button id="currentPage" class="join-item btn btn-sm w-[34px] no-activate">1</button>
                        <button id="nextPage" class="join-item btn btn-sm">»</button>
                    </div>

                    <div class="flex flex-wrap justify-end items-center gap-2">
                        <!-- Boutons d'action -->
                        <div class="flex gap-2 none">
                            <button id="exportExcelBtn"
                            class="btn btn-sm bg-green-700 text-white border-green-700 hover:bg-green-800 hover:text-white hover:border-green-700 transition-colors">
                                <i class="fa-solid fa-file-excel"></i>
                                <span class="hidden md:flex">{{__ "admin.users_export_excel"}}</span>
                            </button>
                            <button id="exportCSVBtn"
                            class="btn btn-sm bg-blue-600 text-white border-blue-600 hover:bg-blue-700 hover:text-white hover:border-blue-600 transition-colors">
                                <i class="fa-solid fa-file-csv"></i>
                                <span class="hidden md:flex">{{__ "admin.users_export_csv"}}</span>
                            </button>
                        </div>

                        <!-- Recherche -->
                        <div class="flex gap-2">
                            <!-- Sélecteur de champ -->
                            <select id="searchFieldSelect" class="select select-sm select-bordered w-max">
                                <option value="auto" selected>Auto</option>
                                <option value="login">Login</option>
                                <option value="email">Email</option>
                                <option value="role">{{__ "admin.users_col_role"}}</option>
                                <option value="created_by">{{__ "admin.users_created_by"}}</option>
                            </select>

                            <!-- Input de recherche -->
                            <div class="relative">
                                <input type="text" id="searchInput" placeholder="{{__ "admin.users_search_placeholder"}}"
                                class="input input-sm input-bordered w-full md:w-64 pr-8">
                                <button id="clearSearch"
                                class="absolute right-2 top-1/2 -translate-y-1/2 text-neutral-content hover:text-neutral hidden">
                                    <i class="fa-solid fa-times"></i>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Table -->
            <div id="tableUsers" class="overflow-x-auto w-full">
                <table class="table w-full table-pin-cols">
                    <thead id="users_table_head" class="text-[14px] bg-base-200">
                        <tr>
                            <th>{{__ "admin.users_col_login"}}</th>
                            <th>{{__ "admin.users_col_status"}}</th>
                            <th>{{__ "admin.users_col_email"}}</th>
                            <th>{{__ "admin.users_col_last_connection"}}</th>
                            <th>{{__ "admin.users_col_role"}}</th>
                            <th>{{__ "admin.users_col_created_by"}}</th>
                            <th>{{__ "admin.users_col_created_at"}}</th>
                            <th class="text-right">{{__ "admin.users_col_actions"}}</th>
                        </tr>
                    </thead>
                    <tbody id="users_table_body">
                        <!-- Rempli par JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Message de chargement -->
            <div id="loading_users" class="flex flex-col rounded-lg border-dashed border border-neutral-content items-center justify-center py-12 gap-4">
                <i class="fa-solid fa-spinner fa-spin text-5xl text-neutral-content"></i>
                <p class="text-sm text-neutral text-center select-none">
                    {{__ "admin.users_loading"}}
                </p>
            </div>

            <!-- Message quand aucun utilisateur -->
            <div id="no_users" class="flex flex-col rounded-lg border-dashed border border-neutral-content items-center justify-center py-12 gap-4 none">
                <i class="fa-solid fa-users text-5xl text-neutral-content"></i>
                <p class="text-sm text-neutral text-center select-none">
                    {{__ "admin.users_empty"}}
                </p>
            </div>
        </div>
    </div>
</div>

{{> components/modals/create-user }}
{{> components/modals/delete-user }}

<script src="/js/admin/users.js"></script>
