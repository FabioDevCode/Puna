{{#slot "title"}}
    <h3 class="font-inter truncate ellipsis-truncate title-max-w mt-[6px]">
        {{__ "profile.title"}}
    </h3>
{{/slot}}

{{#if show2FABanner}}
    <div class="col-span-2 md:col-span-6 lg:col-span-12">
        <div class="bg-secondary text-white shadow-lg rounded-xl p-2 pb-4 border-4 border-base-100">
            <div class="p-2 px-4 flex flex-col justify-left items-center gap-2">
                <span class="py-2 text-center text-white">
                    <i class="fas fa-shield-alt mr-1"></i>
                    {{__ "twoFactor.banner_message"}}
                </span>
                <a href="/dp-2fa-setup" class="btn btn-sm btn-wide shadow-sm">
                    {{__ "twoFactor.banner_setup"}}
                </a>
            </div>
        </div>
    </div>
{{/if}}

<div class="col-span-2 md:col-span-6 lg:col-span-6">
    <div class="card bg-base-100 shadow-xl rounded-xl">
        <div class="card-body p-6">
            <h2 class="card-title text-base font-semibold mb-1">{{__ "profile.info_title"}}</h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-2 py-1">
                <div>
                    <span class="text-sm text-gray-500">{{__ "profile.login_label"}}</span>
                    <p class="font-medium mb-1">
                        {{user.login}}
                    </p>
                </div>
                <div>
                    <span class="text-sm text-gray-500">{{__ "profile.role_label"}}</span>
                    <p class="mb-1">
                        <span class="badge badge-outline badge_role badge-lg badge_{{user.role}}">
                            {{user.role}}
                        </span>
                    </p>
                </div>
                <div>
                    <span class="text-sm text-gray-500">{{__ "profile.2fa_label"}}</span>
                    <p class="font-medium mb-1">
                        {{#if user.totp_enabled}}
                            <span class="badge badge-success badge-sm">{{__ "profile.2fa_enabled"}}</span>
                        {{else}}
                            <span class="badge badge-error badge-sm">{{__ "profile.2fa_disabled"}}</span>
                        {{/if}}
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="col-span-2 md:col-span-6 lg:col-span-6">
    <div class="card bg-base-100 shadow-xl rounded-xl">
        <div class="card-body p-6">
            <h2 class="card-title text-base font-semibold mb-1">{{__ "profile.language_title"}}</h2>
            <p class="text-sm text-gray-500 mb-2">{{__ "profile.language_desc"}}</p>

            <form action="/profile/locale" method="post">
                <input type="hidden" name="_csrf" value="{{csrfToken}}" />
            <div class="flex items-center gap-3">
                <select name="locale" class="select select-sm select-bordered">
                    <option value="fr" {{#ifEquals user.locale "fr"}}selected{{/ifEquals}}>Français</option>
                    <option value="en" {{#ifEquals user.locale "en"}}selected{{/ifEquals}}>English</option>
                </select>
                <button type="submit" class="btn btn-sm btn-secondary">
                    {{__ "btn.apply"}}
                </button>
            </div>
        </form>
    </div>
</div>
</div>
