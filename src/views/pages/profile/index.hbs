{{#slot "title"}}
    <h3 class="font-inter truncate ellipsis-truncate title-max-w mt-[6px]">
        {{__ "profile.title"}}
    </h3>
{{/slot}}

{{#if show2FABanner}}
    <div class="col-span-2 md:col-span-6 lg:col-span-12">
        <div class="bg-secondary text-white shadow-lg rounded-lg p-2 pb-4">
            <div class="p-2 px-4 flex flex-col justify-left items-center gap-2">
                <span class="py-2 text-center text-white">
                    <i class="fas fa-shield-alt mr-1"></i>
                    {{__ "twoFactor.banner_message"}}
                </span>
                <a href="/dp-2fa-setup" class="btn btn-sm btn-wide shadow-sm">
                    {{__ "twoFactor.banner_setup"}}
                </a>
            </div>
        </div>
    </div>
{{/if}}

<div class="col-span-2 md:col-span-6 lg:col-span-7">
    <div class="card bg-base-100 shadow-xl rounded-lg min-h-[160px]">
        <div class="card-body p-6">
            <h2 class="card-title text-base font-semibold mb-1">{{__ "profile.info_title"}}</h2>

            <div class="grid grid-cols-1 md:grid-cols-10 gap-4 mt-2 py-1">
                <div class="md:col-span-3">
                    <span class="text-sm text-gray-500">{{__ "profile.login_label"}}</span>
                    <p class="font-medium mb-1">
                        {{user.login}}
                    </p>
                </div>
                <div class="md:col-span-3">
                    <span class="text-sm text-gray-500">{{__ "profile.role_label"}}</span>
                    <p class="mb-1">
                        <span class="badge badge-outline badge_role badge-md badge_{{user.role}}">
                            {{user.role}}
                        </span>
                    </p>
                </div>
                <div class="md:col-span-4">
                    <span class="text-sm text-gray-500">{{__ "profile.2fa_label"}}</span>
                    <p class="font-medium mb-1">
                        {{#if user.totp_enabled}}
                            <span class="badge badge-success badge-sm">{{__ "profile.2fa_enabled"}}</span>
                        {{else}}
                            <span class="badge badge-error badge-sm">{{__ "profile.2fa_disabled"}}</span>
                        {{/if}}
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="col-span-2 md:col-span-6 lg:col-span-5">
    <div class="card bg-base-100 shadow-xl rounded-lg min-h-[160px]">
        <div class="card-body p-6">
            <h2 class="card-title text-base font-semibold">{{__ "profile.language_title"}}</h2>
            <p class="text-sm text-gray-500 mb-2">{{__ "profile.language_desc"}}</p>

            <form action="/profile/locale" method="post">
                <input type="hidden" name="_csrf" value="{{csrfToken}}" />
            <div class="flex items-center gap-3">
                <select name="locale" class="select select-sm select-bordered">
                    <option value="fr" {{#ifEquals user.locale "fr"}}selected{{/ifEquals}}>Français</option>
                    <option value="en" {{#ifEquals user.locale "en"}}selected{{/ifEquals}}>English</option>
                </select>
                <button type="submit" class="btn btn-sm btn-secondary">
                    {{__ "btn.apply"}}
                </button>
            </div>
        </form>
    </div>
</div>
</div>

{{#if showMcpSection}}
    <div class="col-span-2 md:col-span-6 lg:col-span-12">
        <div class="card bg-base-100 shadow-xl rounded-lg">
            <div class="card-body p-6">

                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h2 class="card-title text-base font-semibold mb-2">{{__ "mcp.section_title"}}</h2>
                        <p class="text-sm text-gray-500">{{__ "mcp.section_desc"}}</p>
                    </div>
                    <button id="btn-new-mcp-key" class="btn btn-sm btn-secondary">
                        <i class="fas fa-plus"></i>
                        <span class="hidden md:flex">{{__ "mcp.btn_new_key"}}</span>
                    </button>
                </div>

                <div class="overflow-x-auto w-full">
                    <table class="table w-full" id="mcp-keys-table">
                        <thead class="text-[14px]">
                            <tr>
                                <th>{{__ "mcp.col_name"}}</th>
                                <th>{{__ "mcp.col_scope"}}</th>
                                <th>{{__ "mcp.col_created_at"}}</th>
                                <th>{{__ "mcp.col_expires"}}</th>
                                <th>{{__ "mcp.col_last_used"}}</th>
                                <th class="text-right">{{__ "mcp.col_actions"}}</th>
                            </tr>
                        </thead>
                        <tbody id="mcp-keys-body">
                            <tr id="mcp-keys-empty">
                                <td colspan="6" class="text-center text-gray-400 py-6">
                                    <i class="fas fa-key mr-2"></i>{{__ "mcp.empty_state"}}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>

    {{> components/modals/delete-mcp-key}}
    {{> components/modals/new-mcp-key}}
    {{> components/modals/show-mcp-token}}

    <script src="/js/views/mcp-keys.js"></script>
{{/if}}
