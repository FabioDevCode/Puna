{{#slot "title"}}
    <h2 class="mt-[6px]">
        Site web
    </h2>
{{/slot}}
{{#slot "buttons"}}
    {{> _ui/search_site }}

    {{> _ui/btn_new_site }}
{{/slot}}

{{#each sites}}
