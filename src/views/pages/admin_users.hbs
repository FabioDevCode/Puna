{{#slot "title"}}
<div class="flex items-center gap-4">
    <h3 class="font-inter">Utilisateurs</h3>
</div>
{{/slot}}

{{#slot "buttons"}}
<button onclick="createUserModal.showModal()" class="btn btn-sm btn-secondary gap-2">
    <i class="fa-solid fa-plus"></i>
    Nouvel utilisateur
</button>
{{/slot}}


<!-- Card: Liste des utilisateurs -->
<div class="h-full col-span-2 md:col-span-6 lg:col-span-12">
    <div class="card h-full bg-base-100 shadow-xl">
        <div id="userContainer" class="card-body h-full p-4 overflow-hidden">
            <!-- Actions de la table -->
            <div id="tableActions">
                <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                    <div class="flex items-center gap-2">
                        <!-- Sélecteur de nombre de lignes et compteur -->
                        <select id="numLignTable" class="select select-sm select-bordered w-max">
                            <option value="10" selected>10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <div id="count_users" class="text-sm min-w-[102px] select-none"></div>
                    </div>

                    <!-- Pagination -->
                    <div id="paginationTable" class="join">
                        <button id="prevPage" class="join-item btn btn-sm">«</button>
                        <button id="currentPage" class="join-item btn btn-sm w-[34px] no-activate">1</button>
                        <button id="nextPage" class="join-item btn btn-sm">»</button>
                    </div>

                    <div class="flex flex-wrap justify-end items-center gap-2">
                        <!-- Boutons d'action -->
                        <div class="flex gap-2 none">
                            <button id="exportExcelBtn"
                                class="btn btn-sm bg-green-700 text-white border-green-700 hover:bg-green-800 hover:text-white hover:border-green-700 transition-colors">
                                <i class="fa-solid fa-file-excel"></i>
                                <span class="hidden md:flex">Exporter un Excel</span>
                            </button>
                        </div>

                        <!-- Recherche -->
                        <div class="relative">
                            <input type="text" id="searchInput" placeholder="Rechercher..."
                                class="input input-sm input-bordered w-full md:w-64 pr-8">
                            <button id="clearSearch"
                                class="absolute right-2 top-1/2 -translate-y-1/2 text-neutral-content hover:text-neutral hidden">
                                <i class="fa-solid fa-times"></i>
                            </button>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Table -->
            <div id="tableUsers" class="overflow-x-auto w-full">
                <table class="table w-full table-pin-cols">
                    <thead id="users_table_head" class="text-[14px] bg-base-200">
                        <tr>
                            <th>Email</th>
                            <th>Login</th>
                            <th>Rôle</th>
                            <th>Créé par</th>
                            <th>Activé</th>
                            <th>Dernière connexion</th>
                            <th>Créé le</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="users_table_body">
                        <!-- Rempli par JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Message de chargement -->
            <div id="loading_users"
                class="flex flex-col rounded-xl border-dashed border border-neutral-content items-center justify-center py-12 gap-4">
                <i class="fa-solid fa-spinner fa-spin text-5xl text-neutral-content"></i>
                <p class="text-sm text-neutral text-center select-none">
                    Chargement des utilisateurs...
                </p>
            </div>

            <!-- Message quand aucun utilisateur -->
            <div id="no_users"
                class="flex flex-col rounded-xl border-dashed border border-neutral-content items-center justify-center py-12 gap-4 none">
                <i class="fa-solid fa-users text-5xl text-neutral-content"></i>
                <p class="text-sm text-neutral text-center select-none">
                    Aucun utilisateur trouvé
                </p>
            </div>
        </div>
    </div>
</div>

<script src="/js/admin_users.js"></script>

<!-- Modal Création Utilisateur -->
<dialog id="createUserModal" class="modal">
    <div class="modal-box w-11/12 max-w-2xl">
        <h3 class="font-bold text-lg mb-6">
            Nouvel utilisateur
        </h3>

        <form action="/admin/users/create" method="POST" class="flex flex-col gap-4">
            <!-- Login & Email -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="form-control w-full">
                    <label class="label">
                        <span class="label-text font-semibold">Login <span class="text-error">*</span></span>
                    </label>
                    <input type="text" name="login" placeholder="ex: jdupont" class="input input-bordered w-full"
                        required />
                </div>

                <div class="form-control w-full">
                    <label class="label">
                        <span class="label-text font-semibold">Email <span class="text-error">*</span></span>
                    </label>
                    <input type="email" name="email" placeholder="ex: jean.dupont@example.com"
                        class="input input-bordered w-full" required />
                </div>
            </div>

            <!-- Role -->
            <div class="form-control w-full">
                <label class="label">
                    <span class="label-text font-semibold">Rôle <span class="text-error">*</span></span>
                </label>
                <select name="role" class="select select-bordered w-full" required>
                    <option value="" disabled selected>Sélectionner un rôle</option>
                    <option value="viewer">Viewer (Lecture seule)</option>
                    <option value="editor">Editor (Peut modifier)</option>
                    <option value="owner">Owner (Propriétaire)</option>
                    <option value="beta">Beta Tester</option>
                    <!-- Super Admin réservé -->
                </select>
            </div>

            <!-- Sites assignés -->
            <div class="form-control w-full">
                <label class="label">
                    <span class="label-text font-semibold">Sites assignés</span>
                    <span class="label-text-alt text-neutral">Maintenir Ctrl/Cmd pour sélectionner plusieurs</span>
                </label>
                <select name="sites" class="select select-bordered w-full h-32" multiple="multiple">
                    {{#each sites}}
                    <option value="{{this.id}}">
                        {{this.domain}}
                    </option>
                    {{else}}
                    <option disabled>Aucun site disponible</option>
                    {{/each}}
                </select>
                <label class="label">
                    <span class="label-text-alt">L'utilisateur aura accès uniquement à ces sites.</span>
                </label>
            </div>

            <div class="modal-action mt-6">
                <form method="dialog">
                    <button class="btn btn-sm">Annuler</button>
                </form>
                <button type="submit" class="btn btn-sm btn-secondary gap-2">
                    <i class="fa-solid fa-check"></i>
                    Créer l'utilisateur
                </button>
            </div>
        </form>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>