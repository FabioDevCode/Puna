{{#slot "title"}}
    <h3 class="font-inter truncate ellipsis-truncate title-max-w mt-[6px]">
        Site web
    </h3>
{{/slot}}

{{#slot "buttons"}}
    {{> components/search/site-search }}
    {{#actionCan entity='site' action='create'}}
        {{> components/buttons/new-site }}
    {{/actionCan}}
{{/slot}}

{{#each sites}}
    {{> components/cards/site
    id=id
    domain=domain
    form=form
    inbox=inbox
    }}
{{else}}
    <div class="col-span-2 md:col-span-6 lg:col-span-12">
        <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
                <div class="flex flex-col items-center justify-center py-12 gap-4">
                    <i class="fa-solid fa-network-wired text-5xl text-neutral-content"></i>
                    <h3 class="text-xl font-bold text-neutral">Aucun site web</h3>
                    <p class="text-sm text-neutral-content text-center max-w-md">
                        Vous n'avez pas encore créé de site. Cliquez sur le bouton "Nouveau" pour commencer.
                    </p>
                </div>
            </div>
        </div>
    </div>
{{/each}}
