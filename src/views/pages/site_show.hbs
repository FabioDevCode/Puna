{{#slot "title"}}
    <h3 class="font-inter col-12">
        {{site.domain}}
    </h3>
{{/slot}}

{{#slot "buttons"}}
    <button id="btn_copy_token" class="btn btn-sm btn-outline" data-site-id="{{site.id}}">
        <i class="fa-solid fa-clone"></i>
        Copier un token
    </button>

    <button id="btn_revoke_tokens" data-site-id="{{site.id}}" class="btn btn-sm btn-outline btn-primary">
        <i class="fa-solid fa-rotate"></i>
        Revoquer les tokens
    </button>

    {{> _ui/delete_site
        id=site.id
        domain=site.domain
    }}
{{/slot}}


<div class="flex items-start flex-wrap justify-between gap-6 h-max col-span-2 md:col-span-6 lg:col-span-12">
    <div class="flex flex-wrap gap-2 col-span-2 md:col-span-3 lg:col-span-6">
        <div id="info_form_panel" class="w-full min-h-[72px] flex flex-col items-start justify-start gap-1 col-span-2 md:col-span-3 lg:col-span-6">
            <div class="w-full min-h-[36px] flex items-center justify-start gap-3">
                <h4 class="text-2xl font-bold mt-1 opacity-25" id="info_form_name">
                    Formulaire
                </h4>
                <button class="btn btn-sm btn-error none" id="btn_delete_form" onclick="document.getElementById('modal_delete_form').showModal()">
                    <i class="far fa-trash-alt"></i>
                    <span>Supprimer</span>
                </button>
                {{> _ui/delete_form_modal }}
            </div>

            <div class="flex min-h-[36px] jutify-center items-center gap-2 opacity-25" id="info_form_code_wrap">
                <strong class="mt-1 select-none">CODE :</strong>
                <p id="info_form_code" class="mt-1"></p>
                <button id="btn_copy_code" class="btn btn-sm btn-outline none">
                    <i class="fa-solid fa-clone"></i>
                    <span>Copier le code</span>
                </button>
            </div>
        </div>
    </div>

    {{> _ui/form_template_modal }}
</div>

<div class="flex items-start items-center justify-cneter gap-4 mt-6 md:mt-0 h-max col-span-2 md:col-span-6 lg:col-span-12">
    {{#if forms}}
        <div class="flex items-center gap-0 w-full">
            <div role="tablist" class="tabs tabs-boxed flex flex-wrap">
                {{#each forms}}
                    <a role="tab" class="tab {{#if @first}}tab-active{{/if}}" data-id="{{this.id}}" data-code="{{this.code}}" data-name="{{this.name}}" data-template="{{this.template}}">
                        {{this.name}}
                    </a>
                {{/each}}
            </div>
            <div class="divider divider-horizontal mx-0 py-3"></div>
            {{> _ui/btn_new_form
                id=site.id
            }}
        </div>
    {{else}}
        <div class="col-12 flex justify-center items-center gap-2">
            {{> _ui/btn_new_form
                id=site.id
            }}
        </div>
    {{/if}}
</div>

<div class="flex flex-col items-start justify-cneter gap-4 mt-6 md:mt-0 h-max col-span-2 md:col-span-6 lg:col-span-12">
    <div class="w-full flex items-end justify-between gap-2 mt-2">
        <div id="count_inbox" class="font-bold text-lg"></div>

        <div id="tableBtns" class="flex gap-2 none">
            {{!-- <div class="join">
                <button class="join-item btn btn-sm">«</button>
                <button class="join-item btn btn-sm">22</button>
                <button class="join-item btn btn-sm">»</button>
            </div> --}}

            <button class="btn btn-sm">
                <i class="fa-solid fa-filter"></i>
                Filtre
            </button>
            <button class="btn btn-sm">
                <i class="fa-solid fa-table-columns"></i>
                Choix des colonnes
            </button>
        </div>
    </div>

    <div id="tableInbox" class="overflow-x-auto w-full border border-base-200">
        <table class="table w-full table-pin-cols bg-base-100">
            <thead id="inbox_table_head" class="text-[14px]"></thead>
            <tbody id="inbox_table_body"></tbody>
        </table>
    </div>
</div>