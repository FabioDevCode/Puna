{{#slot "title"}}
    <h2 class="mt-[6px]">
        Dashboard
    </h2>
{{/slot}}


{{#each stats}}
    {{#if @first}}
        {{> _ui/stats
            title=name
            value=value
            desc=""
            icon=icon
            class="md:col-span-6 lg:col-span-4"
        }}
    {{else}}
        {{> _ui/stats
            title=name
            value=value
            desc=""
            icon=icon
            class="md:col-span-3 lg:col-span-4"
        }}
    {{/if}}
{{/each}}


{{!-- Faire de diagrame etc pour les stats --}}

<div class="col-span-2 md:col-span-6 lg:col-span-12">
    <div class="stats-grid gap-4">
        {{> _ui/stats_inbox_counts }}

        <div class="bg-secondary-content stats-item stats-item--b">
            Stat B - Date + Heure (last recieve)
        </div>

        {{> _ui/stats_repartition_site }}
    </div>
</div>




