{{#slot "title"}}
    <h2 class="mt-[6px]">
        Dashboard
    </h2>
{{/slot}}


{{!-- Mettre une div englobe le tout pour permettre le scrol --}}

{{#each stats}}
    {{> _ui/stats
        title=name
        value=value
        desc=""
        icon=icon
    }}
{{/each}}

{{!-- Faire de diagrame etc pour les stats --}}

<div id="chartLastRecieve" class="card p-2 bg-secondary-content col-span-2 md:col-span-4 lg:col-span-8"></div>

<div id="chartRepart" class="card p-2 bg-secondary-content col-span-2 md:col-span-2 lg:col-span-4"></div>

<div id="chartLast" class="card p-2 bg-secondary-content col-span-2 md:col-span-2 lg:col-span-4"></div>


<script>
    let options = {
    chart: {
        type: 'line'
    },
    series: [{
        name: 'sales',
        data: [30,40,35,50,49,60,70,91,125]
    }],
    xaxis: {
        categories: [1991,1992,1993,1994,1995,1996,1997, 1998,1999]
    }
    }

    let chart = new ApexCharts(document.querySelector("#chartLastRecieve"), options);
    let chart2 = new ApexCharts(document.querySelector("#chartRepart"), options);
    let chart3 = new ApexCharts(document.querySelector("#chartLast"), options);

    chart.render();
    chart2.render();
    chart3.render();
</script>