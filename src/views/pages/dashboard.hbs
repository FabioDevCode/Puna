            <!-- <span class="badge badge-xs rounded-full bg-error"></span> -->
        </span>
        <!-- Domaine principal -->
        <div class="text-lg font-bold mb-1">exemple.com</div>
        <!-- Infos secondaires -->
        <div class="flex gap-4 text-sm items-center">
            <span class="flex items-center gap-1">
                <i class="fas fa-file-alt"></i>
                5
            </span>
            <span class="flex items-center gap-1">
                <i class="fas fa-inbox"></i>
                12
            </span>
        </div>
    </div>
</div>

