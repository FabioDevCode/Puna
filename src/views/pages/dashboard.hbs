{{#slot "title"}}
    <h2 class="mt-[6px]">
        Dashboard
    </h2>
{{/slot}}


{{#each stats}}
    {{#if @first}}
        {{> _ui/stats
            title=name
            value=value
            desc=""
            icon=icon
            class="md:col-span-6 lg:col-span-4"
        }}
    {{else}}
        {{> _ui/stats
            title=name
            value=value
            desc=""
            icon=icon
            class="md:col-span-3 lg:col-span-4"
        }}
    {{/if}}
{{/each}}

<div class="col-span-2 md:col-span-6 lg:col-span-12">
    <div class="stats-grid gap-4">
        {{> _ui/stats_inbox_counts }}

        {{> _ui/stats_last_receive }}

        {{> _ui/stats_repartition_site }}
    </div>
</div>

<div class="col-span-2 md:col-span-6 lg:col-span-12">
    {{> _ui/stats_inbox_heatmap }}
</div>