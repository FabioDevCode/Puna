{{#slot "title"}}
    <h2 class="mt-[6px]">
        Dashboard
    </h2>
{{/slot}}


{{#each stats}}
    {{#if @first}}
        {{> _ui/stats
            title=name
            value=value
            desc=""
            icon=icon
            class="md:col-span-6 lg:col-span-4"
        }}
    {{else}}
        {{> _ui/stats
            title=name
            value=value
            desc=""
            icon=icon
            class="md:col-span-3 lg:col-span-4"
        }}
    {{/if}}
{{/each}}


{{!-- Faire de diagrame etc pour les stats --}}

<div class="col-span-2 md:col-span-6 lg:col-span-12">
    <div class="stats-grid gap-4">
        <div class="stats-item stats-item--a">
            Stat A - Nombre inbox (7 days || 30 days)
        </div>

        <div class="stats-item stats-item--b">
            Stat B - Date + Heure (last recieve)
        </div>

        <div class="stats-item stats-item--c">
            Stat C - Répartition par site
        </div>
    </div>
</div>



