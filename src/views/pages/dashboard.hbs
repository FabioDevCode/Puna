{{#slot "title"}}
    <h2 class="mt-[6px]">
        Dashboard
    </h2>
{{/slot}}


{{> _ui/stats_inbox_percentages }}

<div class="stats h-max bg-secondary-content overflow-hidden col-span-2 md:col-span-6 lg:col-span-8">
    <div class="stat flex items-center justify-around gap-4 h-[68px] w-full select-none">
        <div class="flex items-center gap-2">
            <div class="stat-figure text-xl">
                <i class="{{stats.globalInbox_icon}}"></i>
            </div>
            <div class="stat-value text-xl">
                {{stats.globalInbox}}
            </div>
        </div>
        <div class="flex items-center gap-2">
            <div class="stat-figure text-xl">
                <i class="{{stats.globalForm_icon}}"></i>
            </div>
            <div class="stat-value text-xl">
                {{stats.globalForm}}
            </div>
        </div>
        <div class="flex items-center gap-2">
            <div class="stat-figure text-xl">
                <i class="{{stats.globalSite_icon}}"></i>
            </div>
            <div class="stat-value text-xl">
                {{stats.globalSite}}
            </div>
        </div>
    </div>
</div>

<div class="stats h-max bg-secondary-content overflow-hidden col-span-2 md:col-span-6 lg:col-span-4">

    formulaire a reçu le plus d'éléèments sur les 7 derniers jours

</div>

<div class="col-span-2 md:col-span-6 lg:col-span-12">
    <div class="stats-grid gap-4">
        {{> _ui/stats_inbox_counts }}

        {{> _ui/stats_last_receive }}

        {{> _ui/stats_repartition_site }}
    </div>
</div>

<div class="col-span-2 md:col-span-6 lg:col-span-12 h-max">
    {{> _ui/stats_inbox_heatmap }}
</div>