    </button>
</div>

<!-- Card Domaine -->
<div class="col-span-2 md:col-span-2 lg:col-span-3">
    <div class="card bg-neutral text-neutral-content shadow-lg relative p-4 px-6 flex flex-col gap-2">
        <!-- Pastille d'état -->
        <span class="absolute top-4 right-6">
            <!-- Exemple : vert si actif, rouge si inactif -->
