{{#slot "title"}}
    <h2 class="mt-[6px]">
        Dashboard
    </h2>
{{/slot}}


{{!-- Mettre une div englobe le tout pour permettre le scrol --}}

{{#each stats}}
    {{> _ui/stats
        title=name
        value=value
        desc=""
        icon=icon
    }}
{{/each}}

