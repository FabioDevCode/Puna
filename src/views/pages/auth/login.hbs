<div class="flex flex-col items-center gap-4 bg-base-100 p-8 rounded-xl shadow-lg border border-base-300" style="width: 360px;">
    <div class="flex items-center mb-4 gap-2">
        <img src="/img/puna_short_logo.png" alt="Puna logo" class="h-16">
        <h1 class="font-inter" style="font-size: 3rem !important;">
            Puna
        </h1>
    </div>

    <h2>
        {{__ "auth.login_title"}}
    </h2>

    <form action="/dp-connect" method="post" class="flex flex-col gap-4 w-full">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
    <label class="input input-sm input-bordered flex items-center gap-2">
        <i class="fas fa-user" style="color: #6C7179; font-size: .8rem;"></i>
        <input name="login" type="text" class="grow" placeholder="Login" maxlength="50" />
</label>

<label class="input input-sm input-bordered flex items-center gap-2">
    <i class="fas fa-key" style="color: #6C7179; font-size: .8rem;"></i>
    <input name="password" type="password" class="grow" placeholder="Password" maxlength="100" />
</label>

<button class="btn btn-secondary btn-sm">
    {{__ "auth.login_submit"}}
</button>

<a href="/dp-first-connexion" class="btn btn-sm btn-wide self-center w-full">
    {{__ "auth.first_login_link"}}
</a>

{{#if mailEnabled}}
    <a href='/dp-forgot-password' class='mt-2 link link-secondary text-sm self-center'>
        {{__ "passwordReset.login_forgot_link"}}
    </a>
{{/if}}
</form>
</div>
