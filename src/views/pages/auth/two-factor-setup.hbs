<div class="flex flex-col items-center gap-4 bg-base-100 p-8 rounded-xl shadow-lg border border-base-300" style="width: 400px;">
    <div class="flex items-center mb-4 gap-2">
        <img src="/img/puna_short_logo.png" alt="Puna logo" class="h-16">
        <h1 class="font-inter" style="font-size: 3rem !important;">
            Puna
        </h1>
    </div>

    <h2>
        {{__ "twoFactor.setup_title"}}
    </h2>

    <p class="text-sm text-center">
        {{__ "twoFactor.setup_subtitle"}}
    </p>

    <img src="{{qrCodeDataUrl}}" alt="QR Code 2FA" class="w-48 h-48 rounded-lg border border-base-300" />

<div class="w-full">
    <p class="text-xs text-center mb-1">{{__ "twoFactor.setup_manual_key"}}</p>
    <div class="bg-base-200 rounded p-2 text-center font-mono text-sm break-all select-all">
        {{manualKey}}
    </div>
</div>

<form action="/dp-2fa-setup" method="post" class="flex flex-col gap-4 w-full">
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />
<label class="input input-sm input-bordered flex items-center gap-2">
    <i class="fas fa-shield-alt" style="color: #6C7179; font-size: .8rem;"></i>
    <input name="totp_code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" class="grow" placeholder="{{__ "twoFactor.setup_verify_placeholder"}}" maxlength="6" required />
</label>
<button class="btn btn-secondary btn-sm">
    {{__ "twoFactor.setup_submit"}}
</button>
</form>

<a href="/dashboard" class="btn btn-sm btn-ghost w-full">
    {{__ "twoFactor.setup_skip"}}
</a>
</div>
