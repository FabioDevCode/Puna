<div class="flex flex-col items-center gap-4 bg-base-100 p-8 rounded-2xl shadow-xl" style="width: 400px;">
    <div class="flex items-center mb-4 gap-2">
        <img src="/img/puna_short_logo.png" alt="Puna logo" class="h-16">
        <h1 class="font-inter" style="font-size: 3rem !important;">
            Puna
        </h1>
    </div>

    <h2>
        {{__ "twoFactor.backup_title"}}
    </h2>

    <div class="alert alert-warning text-sm rounded-xl">
        <i class="fas fa-exclamation-triangle"></i>
        <span>{{__ "twoFactor.backup_warning"}}</span>
    </div>

    <div class="grid grid-cols-2 gap-2 w-full">
        {{#each backupCodes}}
            <div class="font-mono text-center bg-base-200 rounded p-2 text-sm backup-code-item">{{this}}</div>
        {{/each}}
    </div>

    <button id="btn-copy-codes" class="btn btn-sm btn-outline w-full">
        <i class="fas fa-copy" style="font-size: .8rem;"></i> {{__ "twoFactor.backup_copy"}}
    </button>

    <button id="btn-download-codes" class="btn btn-sm btn-outline w-full">
        <i class="fas fa-download" style="font-size: .8rem;"></i> {{__ "twoFactor.backup_download"}}
    </button>

    <a href="/dashboard" class="btn btn-secondary btn-sm w-full">
        {{__ "twoFactor.backup_saved"}}
    </a>
</div>

<script src="/js/auth/backup-codes.js"></script>
