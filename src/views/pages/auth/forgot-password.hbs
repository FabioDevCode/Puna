<div class="flex flex-col items-center gap-4 bg-base-100 p-8 rounded-2xl shadow-xl" style="width: 360px;">
    <div class="flex items-center mb-4 gap-2">
        <img src="/img/puna_short_logo.png" alt="Puna logo" class="h-16">
        <h1 class="font-inter" style="font-size: 3rem !important;">
            Puna
        </h1>
    </div>

    <h2>
        Mot de passe oublié
    </h2>

    {{#unless mailEnabled}}
        <div class="alert alert-warning text-sm">
            La fonctionnalité de réinitialisation du mot de passe n'est pas disponible pour le moment.
        </div>
    {{/unless}}

    {{#if mailEnabled}}
        <form action="/dp-forgot-password" method="post" class="flex flex-col gap-4 w-full">
            <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <label class="input input-sm input-bordered flex items-center gap-2">
            <i class="fas fa-envelope" style="color: #6C7179; font-size: .8rem;"></i>
            <input name="email" type="email" class="grow" placeholder="Adresse email" maxlength="255" required />
    </label>

    <button class="btn btn-secondary btn-sm">
        Envoyer le lien
    </button>
</form>
{{/if}}

<a href="/dp-login" class="btn btn-sm btn-wide self-center w-full">
    Retour à la connexion
</a>
</div>
