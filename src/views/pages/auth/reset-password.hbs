<div class="flex flex-col items-center gap-4 bg-base-100 p-8 rounded-2xl shadow-xl" style="width: 360px;">
    <div class="flex items-center mb-4 gap-2">
        <img src="/img/puna_short_logo.png" alt="Puna logo" class="h-16">
        <h1 class="font-inter" style="font-size: 3rem !important;">
            Puna
        </h1>
    </div>

    <h2>
        Réinitialiser le mot de passe
    </h2>

    {{#if error}}
        <div class="alert alert-error text-sm">
            {{error}}
        </div>
    {{/if}}

    <form action="/dp-reset-password/{{token}}" method="post" class="flex flex-col gap-4 w-full">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
    <label class="input input-sm input-bordered flex items-center gap-2">
        <i class="fas fa-key" style="color: #6C7179; font-size: .8rem;"></i>
        <input name="password" type="password" class="grow" placeholder="Nouveau mot de passe" maxlength="100" required />
</label>

<label class="input input-sm input-bordered flex items-center gap-2">
    <i class="fas fa-key" style="color: #6C7179; font-size: .8rem;"></i>
    <input name="confirm_password" type="password" class="grow" placeholder="Confirmer le mot de passe" maxlength="100" required />
</label>

{{#if passwordErrors}}
    <ul class="text-error text-xs list-disc list-inside">
        {{#each passwordErrors}}
            <li>{{this}}</li>
        {{/each}}
    </ul>
{{/if}}

<div class="text-xs text-base-content/60">
    <ul class="list-disc list-inside space-y-0.5">
        <li>{{__ "password.min_length"}}</li>
        <li>{{__ "password.needs_uppercase"}}</li>
        <li>{{__ "password.needs_lowercase"}}</li>
        <li>{{__ "password.needs_digit"}}</li>
        <li>{{__ "password.needs_special"}}</li>
    </ul>
</div>

<button class="btn btn-secondary btn-sm">
    Réinitialiser
</button>

<a href="/dp-login" class="btn btn-sm btn-wide self-center w-full">
    Retour à la connexion
</a>
</form>
</div>
