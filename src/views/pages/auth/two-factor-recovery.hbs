<div class="flex flex-col items-center gap-4 bg-base-100 p-8 rounded-xl shadow-2xl" style="width: 360px;">
    <div class="flex items-center mb-4 gap-2">
        <img src="/img/puna_short_logo.png" alt="Puna logo" class="h-16">
        <h1 class="font-inter" style="font-size: 3rem !important;">
            Puna
        </h1>
    </div>

    <h2>
        {{__ "twoFactor.recovery_title"}}
    </h2>

    <p class="text-sm text-center">
        {{__ "twoFactor.recovery_subtitle"}}
    </p>

    <form action="/dp-2fa-recovery" method="post" class="flex flex-col gap-4 w-full">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
    <label class="input input-sm input-bordered flex items-center gap-2">
        <i class="fas fa-life-ring" style="color: #6C7179; font-size: .8rem;"></i>
        <input name="recovery_code" type="text" class="grow" placeholder="{{__ "twoFactor.recovery_placeholder"}}" maxlength="9" required />
</label>

<button class="btn btn-secondary btn-sm">
    {{__ "twoFactor.recovery_submit"}}
</button>
</form>

<a href="/dp-2fa-verify" class="btn btn-sm w-full">
    {{__ "twoFactor.recovery_back_totp"}}
</a>

<a href="/dp-login" class="link link-secondary text-sm">
    {{__ "twoFactor.back_login"}}
</a>
</div>
