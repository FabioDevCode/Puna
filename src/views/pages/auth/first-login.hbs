<div class="flex flex-col items-center gap-2 bg-base-100 p-8 rounded-2xl shadow-xl" style="width: 360px;">
    <div class="flex items-center mb-4 gap-2">
        <img src="/img/puna_short_logo.png" alt="Puna logo" class="h-16">
        <h1 class="font-inter" style="font-size: 3rem !important;">
            Puna
        </h1>
    </div>

    <h2>
        {{__ "auth.first_login_title"}}
    </h2>

    {{#if error}}
        <div class="alert alert-error text-sm rounded-md w-full mb-2">
            {{error}}
        </div>
    {{/if}}

    <form action="/dp-first-co" method="post" class="flex flex-col gap-4 w-full">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
    <label class="input input-sm input-bordered flex items-center gap-2">
        <i class="fas fa-user" style="color: #6C7179; font-size: .8rem;"></i>
        <input name="login" type="text" class="grow" placeholder="Login" maxlength="50" />
</label>

<label class="input input-sm input-bordered flex items-center gap-2">
    <i class="fas fa-key" style="color: #6C7179; font-size: .8rem;"></i>
    <input name="password" type="password" class="grow" placeholder="Password" maxlength="100" />
</label>

<label class="input input-sm input-bordered flex items-center gap-2">
    <i class="fas fa-key" style="color: #6C7179; font-size: .8rem;"></i>
    <input name="confirm_password" type="password" class="grow" placeholder="Confirm password" maxlength="100" />
</label>

{{#if passwordErrors}}
    <ul class="text-error text-xs list-disc list-inside">
        {{#each passwordErrors}}
            <li>{{this}}</li>
        {{/each}}
    </ul>
{{/if}}

<div class="text-xs text-base-content/60" data-pwd-rules>
    <p class="mb-1">
        {{__ "password.instruct"}}
    </p>
    <ul class="list-disc list-inside space-y-0.5 pl-4">
        <li data-rule="min_length">{{__ "password.min_length"}}</li>
        <li data-rule="uppercase">{{__ "password.needs_uppercase"}}</li>
        <li data-rule="lowercase">{{__ "password.needs_lowercase"}}</li>
        <li data-rule="digit">{{__ "password.needs_digit"}}</li>
        <li data-rule="special">{{__ "password.needs_special"}}</li>
    </ul>
</div>

<button class="btn btn-secondary btn-sm" data-pwd-submit>
    {{__ "auth.first_login_submit"}}
</button>

<a href="/dp-login" class="btn btn-sm btn-wide self-center w-full">
    {{__ "auth.login_link"}}
</a>
</form>
</div>
<script src="/js/auth/password-strength.js"></script>
