{{#slot "title"}}
<h3 class="font-inter">Administration</h3>
{{/slot}}

<!-- Vue d'ensemble -->
<div class="col-span-2 md:col-span-6 lg:col-span-12">
    <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
            <h2 class="card-title text-2xl">
                <i class="fa-solid fa-gauge text-primary"></i>
                Administration - Vue d'ensemble
            </h2>
            <p class="text-neutral-content">
                Bienvenue dans l'espace d'administration de Puna.
            </p>
        </div>
    </div>
</div>

<!-- Statistiques rapides -->
<div class="col-span-2 md:col-span-2 lg:col-span-3">
    <div class="stats shadow w-full">
        <div class="stat">
            <div class="stat-figure text-primary">
                <i class="fa-solid fa-users text-3xl"></i>
            </div>
            <div class="stat-title">Utilisateurs</div>
            <div class="stat-value text-primary">-</div>
            <div class="stat-desc">Prochainement</div>
        </div>
    </div>
</div>

<div class="col-span-2 md:col-span-2 lg:col-span-3">
    <div class="stats shadow w-full">
        <div class="stat">
            <div class="stat-figure text-secondary">
                <i class="fa-solid fa-globe text-3xl"></i>
            </div>
            <div class="stat-title">Sites</div>
            <div class="stat-value text-secondary">-</div>
            <div class="stat-desc">Prochainement</div>
        </div>
    </div>
</div>

<div class="col-span-2 md:col-span-2 lg:col-span-3">
    <div class="stats shadow w-full">
        <div class="stat">
            <div class="stat-figure text-accent">
                <i class="fa-solid fa-file-lines text-3xl"></i>
            </div>
            <div class="stat-title">Formulaires</div>
            <div class="stat-value text-accent">-</div>
            <div class="stat-desc">Prochainement</div>
        </div>
    </div>
</div>

<div class="col-span-2 md:col-span-2 lg:col-span-3">
    <div class="stats shadow w-full">
        <div class="stat">
            <div class="stat-figure text-info">
                <i class="fa-solid fa-inbox text-3xl"></i>
            </div>
            <div class="stat-title">Entrées</div>
            <div class="stat-value text-info">-</div>
            <div class="stat-desc">Prochainement</div>
        </div>
    </div>
</div>