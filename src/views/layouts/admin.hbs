        {{> layout/head}}
        <script src="/js/core/utils.js"></script>
        <script src="/js/tabs.js"></script>
        <script src="/js/admin/sidebar.js"></script>
    </head>

    <body>
        <div class="flex h-screen overflow-hidden w-full min-w-[320px]">
            {{> layout/admin-sidebar}}
