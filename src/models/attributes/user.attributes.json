{
    "created_by": {
        "allowNull": true,
        "defaultValue": null,
        "type": "UUID"
    },
    "email": {
        "allowNull": true,
        "type": "STRING"
    },
    "failed_login_attempts": {
        "allowNull": false,
        "defaultValue": 0,
        "type": "INTEGER"
    },
    "id": {
        "allowNull": false,
        "primaryKey": true,
        "type": "UUID",
        "unique": true
    },
    "last_connection": {
        "allowNull": true,
        "type": "DATE"
    },
    "login": {
        "allowNull": false,
        "type": "STRING(100)",
        "unique": true
    },
    "password": {
        "allowNull": true,
        "type": "STRING"
    },
    "password_reset_expires": {
        "allowNull": true,
        "type": "DATE"
    },
    "password_reset_token": {
        "allowNull": true,
        "type": "STRING"
    },
    "role": {
        "allowNull": false,
        "defaultValue": "viewer",
        "type": "ENUM",
        "values": ["super_admin", "owner", "editor", "viewer", "beta"]
    },
    "status": {
        "allowNull": false,
        "defaultValue": "pending",
        "type": "ENUM",
        "values": ["pending", "active", "inactive", "suspended", "banned", "anonymized"]
    },
    "totp_backup_codes": {
        "allowNull": true,
        "defaultValue": null,
        "type": "TEXT"
    },
    "totp_enabled": {
        "allowNull": false,
        "defaultValue": false,
        "type": "BOOLEAN"
    },
    "totp_secret": {
        "allowNull": true,
        "defaultValue": null,
        "type": "STRING"
    }
}
