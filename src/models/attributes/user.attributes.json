{
    "email": {
        "allowNull": true,
        "type": "STRING"
    },
    "enabled": {
        "allowNull": false,
        "defaultValue": false,
        "type": "BOOLEAN"
    },
    "id": {
        "allowNull": false,
        "primaryKey": true,
        "type": "UUID",
        "unique": true
    },
    "last_connection": {
        "allowNull": true,
        "type": "DATE"
    },
    "login": {
        "allowNull": false,
        "type": "STRING(100)",
        "unique": true
    },
    "password": {
        "allowNull": true,
        "type": "STRING"
    }
}
