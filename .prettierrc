{
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "useTabs": false,
    "trailingComma": "es5",
    "printWidth": 120,
    "arrowParens": "always",
    "endOfLine": "lf",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "plugins": ["prettier-plugin-handlebars"],
    "overrides": [
        {
            "files": "*.hbs",
            "options": {
                "parser": "glimmer",
                "singleQuote": false,
                "printWidth": 120
            }
        }
    ]
}
