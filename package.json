{
	"name": "puna",
	"version": "1.0.0",
	"description": "Centralisez tous vos formulaires au même endroit",
	"main": "server.js",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"setup": "node scripts/setup.js",
		"dev": "node --env-file=.env --watch server.js",
		"start": "node --env-file=.env server.js",
		"prepare": "husky",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"**/*.{js,json}\" && node scripts/format-hbs.js \"src/views/**/*.hbs\"",
		"format:check": "prettier --check \"**/*.{js,json}\"",
		"format:hbs": "node scripts/format-hbs.js \"src/views/**/*.hbs\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:coverage:badges": "vitest run --coverage && istanbul-badges-readme",
		"test:e2e": "npx playwright test",
		"test:e2e:ui": "npx playwright test --ui",
		"test:e2e:seed": "node --env-file=.env.test scripts/seed-e2e.js",
		"logs:clean": "node scripts/clean-logs.js",
		"logs:stats": "node scripts/logs-stats.js",
		"logs:rotate": "node scripts/rotate-logs.js",
		"seed:demo": "node --env-file=.env docs/scripts/seed-screenshots.js && node --env-file=.env docs/scripts/seed-users-screenshots.js",
		"mcp:inspector": "npx @modelcontextprotocol/inspector"
	},
	"lint-staged": {
		"*.js": [
			"eslint --fix",
			"prettier --write"
		],
		"*.json": [
			"prettier --write"
		],
		"*.hbs": [
			"node scripts/format-hbs.js"
		]
	},
	"keywords": [
		"Puna"
	],
	"author": "Fabio RAMOS LOPES",
	"license": "AGPLv3",
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"archiver": "^7.0.1",
		"bcrypt": "^6.0.0",
		"clamscan": "^2.4.0",
		"console-stamp": "^3.1.2",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"crypto-js": "^4.2.0",
		"csrf-csrf": "^4.0.3",
		"dayjs": "^1.11.18",
		"exceljs": "^4.4.0",
		"express": "^5.1.0",
		"express-handlebars": "^8.0.2",
		"express-mysql-session": "^3.0.3",
		"express-rate-limit": "^8.2.1",
		"express-session": "^1.18.2",
		"fast-csv": "^5.0.5",
		"file-type": "^21.1.0",
		"handlebars": "^4.7.8",
		"helmet": "^8.1.0",
		"i18n": "^0.15.2",
		"jsonwebtoken": "^9.0.2",
		"mariadb": "^3.4.5",
		"multer": "^2.0.2",
		"node-cron": "^4.2.1",
		"node-stream-zip": "^1.15.0",
		"nodemailer": "^8.0.5",
		"otpauth": "^9.5.0",
		"passport": "^0.7.0",
		"passport-local": "^1.0.0",
		"pino": "^10.1.0",
		"pino-http": "^11.0.0",
		"qrcode": "^1.5.4",
		"sanitize-filename": "^1.6.3",
		"sequelize": "^6.37.7",
		"split": "^1.0.1",
		"tar": "^7.5.2",
		"uuid": "^13.0.0",
		"xss": "^1.0.15",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.3",
		"@playwright/test": "^1.59.1",
		"@vitest/coverage-v8": "^4.1.3",
		"eslint": "^9.39.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.16.1",
		"eslint-plugin-jsonc": "^2.21.1",
		"eslint-plugin-prettier": "^5.5.5",
		"glob": "^13.0.0",
		"globals": "^17.3.0",
		"husky": "^9.1.7",
		"istanbul-badges-readme": "^1.9.0",
		"jsonc-eslint-parser": "^2.4.2",
		"lint-staged": "^16.2.7",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.7.1",
		"prettier-plugin-handlebars": "^0.0.1",
		"sqlite3": "^6.0.1",
		"supertest": "^7.2.2",
		"vitest": "^4.0.18"
	},
	"overrides": {
		"minimatch": "^10.2.1"
	}
}
