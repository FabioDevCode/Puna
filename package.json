{
	"name": "puna",
	"version": "0.0.1",
	"description": "Application de gestion de feedbacks",
	"main": "server.js",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "node --env-file=.env --watch server.js",
		"start": "node --env-file=.env server.js",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"**/*.{js,json}\" && node scripts/format-hbs.js \"src/views/**/*.hbs\"",
		"format:check": "prettier --check \"**/*.{js,json}\"",
		"format:hbs": "node scripts/format-hbs.js \"src/views/**/*.hbs\"",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.js": [
			"eslint --fix",
			"prettier --write"
		],
		"*.json": [
			"prettier --write"
		],
		"*.hbs": [
			"node scripts/format-hbs.js"
		]
	},
	"keywords": [
		"Puna"
	],
	"author": "Fabio RAMOS LOPES",
	"license": "AGPLv3",
	"dependencies": {
		"archiver": "^7.0.1",
		"bcrypt": "^6.0.0",
		"console-stamp": "^3.1.2",
		"cookie-parser": "^1.4.7",
		"crypto-js": "^4.2.0",
		"dayjs": "^1.11.18",
		"exceljs": "^4.4.0",
		"express": "^5.1.0",
		"express-handlebars": "^8.0.2",
		"express-mysql-session": "^3.0.3",
		"express-session": "^1.18.2",
		"fast-csv": "^5.0.5",
		"file-type": "^21.1.0",
		"handlebars": "^4.7.8",
		"i18n": "^0.15.2",
		"jsonwebtoken": "^9.0.2",
		"mariadb": "^3.4.5",
		"morgan": "^1.10.1",
		"multer": "^2.0.2",
		"node-cron": "^4.2.1",
		"node-stream-zip": "^1.15.0",
		"passport": "^0.7.0",
		"passport-local": "^1.0.0",
		"pino": "^10.1.0",
		"sanitize-filename": "^1.6.3",
		"sequelize": "^6.37.7",
		"split": "^1.0.1",
		"xss": "^1.0.15"
	},
	"devDependencies": {
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsonc": "^2.21.0",
		"eslint-plugin-prettier": "^5.5.4",
		"glob": "^13.0.0",
		"husky": "^9.1.7",
		"jsonc-eslint-parser": "^2.4.1",
		"lint-staged": "^16.2.7",
		"prettier": "^3.7.1",
		"prettier-plugin-handlebars": "^0.0.1"
	}
}
